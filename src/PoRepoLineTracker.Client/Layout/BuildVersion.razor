@using System.Reflection

@* The Po build stamp, vYYMMDD, bottom-right on every page. Each layout renders it once, last in its scrolling column
   (MainLayout inside RadzenBody, BareLayout after main), so it sits in flow and never covers content. The value comes from Directory.Build.props, which stamps the
   server too, so /api/diag reports the same one. *@
@if (Stamp is not null)
{
    <span class="po-version">v@(Stamp)</span>
}

@code {
    private static readonly string? Stamp = typeof(BuildVersion).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value;
}
