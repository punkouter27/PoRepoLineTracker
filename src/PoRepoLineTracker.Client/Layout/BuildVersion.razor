@using System.Reflection

@if (Stamp is not null)
{
    <footer class="app-build-version" aria-label="Build version">v@(Stamp)</footer>
}

@code {
    private static readonly string? Stamp = typeof(BuildVersion).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key is "BuildStamp" or "BuildVersion")?.Value;
}
