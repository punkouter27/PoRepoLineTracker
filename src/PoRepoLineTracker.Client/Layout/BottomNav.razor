@* The phone form of the sidebar: the same AppNav list, so both always offer the same destinations. *@
<nav class="bottom-nav" aria-label="Mobile navigation">
    @foreach (var item in AppNav.Groups.SelectMany(g => g.Items))
    {
        <NavLink class="bottom-nav-link" href="@item.Href" Match="@item.Match">
            <span class="material-symbols-outlined" aria-hidden="true">@item.Icon</span>
            <span>@item.Label</span>
        </NavLink>
    }
</nav>
