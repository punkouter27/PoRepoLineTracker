@* The ONLY copy of the Radzen hosts. MainLayout used to render a second set, so every dialog and
   toast was drawn twice (two overlays, two focus traps). Living here also covers LoginLayout.
   RadzenTooltip stays although nothing calls TooltipService directly: RadzenChart renders its
   series tooltips through it. *@
@using System.Reflection
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@if (BuildVersion is not null)
{
    <div class="app-build-version">v@(BuildVersion)</div>
}

@code {
    /// <summary>Stamped by the AssemblyMetadata item in the client csproj.</summary>
    private static readonly string? BuildVersion = typeof(App).Assembly
        .GetCustomAttributes<AssemblyMetadataAttribute>()
        .FirstOrDefault(a => a.Key == "BuildVersion")?.Value;
}
