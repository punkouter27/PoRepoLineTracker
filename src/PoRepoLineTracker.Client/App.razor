@* The ONLY copy of the Radzen hosts. MainLayout used to render a second set, so every dialog and
   toast was drawn twice (two overlays, two focus traps). Living here also covers BareLayout.
   RadzenTooltip stays although nothing calls TooltipService directly: RadzenChart renders its
   series tooltips through it. *@
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

<BuildVersion />
