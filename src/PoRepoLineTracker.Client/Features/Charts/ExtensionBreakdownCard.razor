@* The "Composition" tab of the repository detail page: extension donut + per-extension bar list.
   Extracted from RepositoryDetail.razor along with the top-eight/Other donut-slice logic, so the
   page keeps only fetch and lifecycle code. The ChartCard supplies the loading/empty chrome.

   Also the Insights page's "Language mix": that was this card written out a second time against
   LanguageShareDto, with its own copy of the bar list and its CSS. The page maps its rows instead. *@
<ChartCard Title="@Title"
           Description="@Description"
           IsEmpty="@(Extensions is null || Extensions.Count == 0)"
           EmptyIcon="donut_large"
           EmptyText="No extension data yet."
           EmptyHint="@EmptyHint">
    <RadzenChart>
        <RadzenDonutSeries Data="@ExtensionSlices"
                           CategoryProperty="Label"
                           ValueProperty="Percentage"
                           Title="Share of lines">
            <RadzenSeriesDataLabels Visible="false" />
        </RadzenDonutSeries>
        <RadzenLegend Position="LegendPosition.Bottom" />
    </RadzenChart>

    <div class="rd-ext-list">
        @foreach (var ext in Extensions!)
        {
            <div class="rd-ext-row">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <code class="rd-ext-code">@ext.FileExtension</code>
                    <RadzenText TextStyle="TextStyle.Caption" class="rd-ext-pct">@(ext.LineCount > 0 ? $"{ext.LineCount:N0} · " : "")@ext.Percentage.ToString("F1")%</RadzenText>
                </RadzenStack>
                <progress class="rd-ext-bar"
                          max="100"
                          value="@Math.Min(ext.Percentage, 100)"
                          aria-label="@($"{ext.FileExtension}: {ext.Percentage:F1}% of lines")"></progress>
            </div>
        }
    </div>
</ChartCard>

@code {
    [Parameter] public IReadOnlyList<FileExtensionPercentageDto>? Extensions { get; set; }

    [Parameter] public string Title { get; set; } = "By Extension";
    [Parameter] public string Description { get; set; } = "Share of tracked lines per file type";
    [Parameter] public string? EmptyHint { get; set; }

    /// <summary>
    /// Donut slices for the extension breakdown. A repository can report dozens of extensions and
    /// a donut with dozens of slivers communicates nothing, so everything past the top eight is
    /// folded into a single "Other" wedge. The exact per-extension figures stay available in the
    /// bar list rendered beneath the chart.
    /// </summary>
    private IReadOnlyList<ExtensionSlice> ExtensionSlices
    {
        get
        {
            if (Extensions is null || Extensions.Count == 0) return [];

            var ranked = Extensions.OrderByDescending(e => e.Percentage).ToList();
            var slices = ranked.Take(8)
                .Select(e => new ExtensionSlice(e.FileExtension, e.Percentage))
                .ToList();

            var remainder = ranked.Skip(8).Sum(e => e.Percentage);
            if (remainder > 0) slices.Add(new ExtensionSlice("Other", remainder));

            return slices;
        }
    }

    private sealed record ExtensionSlice(string Label, double Percentage);
}
