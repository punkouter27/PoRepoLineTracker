@using Microsoft.AspNetCore.Components.Authorization
@using PoRepoLineTracker.Client.Services
@inject ApiAuthenticationStateProvider AuthStateProvider

@* The header's session slot (Layout/PoHeader). Signed in: the account's email when GitHub shared one (the user:email
   scope), else the GitHub login. Signed out: a Sign in link to the sign-in page (a link, not a control; PoHeader leaves
   it out on the sign-in page itself, which already is one). Sign out lives in Settings. *@
<AuthorizeView>
    <Authorized>
        <span class="po-header__email" title="@Identity">@Identity</span>
    </Authorized>
    <NotAuthorized>
        <a class="po-link-btn filled small" href="@AppRoutes.Login" data-testid="header-sign-in">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string Identity => AccountMenu.Identity(AuthStateProvider.CurrentUser);
}
