@using Microsoft.AspNetCore.Components.Authorization
@using PoRepoLineTracker.Client.Services
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@* The header's session slot (Layout/PoHeader). Signed in: the account's email when GitHub shared one (the user:email
   scope), else the GitHub login. Signed out: one Sign in button, the same on every page including /login. Sign out
   lives in Settings. *@
<AuthorizeView>
    <Authorized>
        <span class="po-header__email" title="@Identity">@Identity</span>
    </Authorized>
    <NotAuthorized>
        <button type="button" class="po-link-btn filled small" title="Sign in with GitHub"
                data-testid="header-sign-in" @onclick="HandleLogin">Sign in</button>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string Identity => AccountMenu.Identity(AuthStateProvider.CurrentUser);

    // A server endpoint that starts the GitHub OAuth challenge, so the router must not handle it.
    private void HandleLogin() => Navigation.NavigateTo("auth/login", forceLoad: true);
}
