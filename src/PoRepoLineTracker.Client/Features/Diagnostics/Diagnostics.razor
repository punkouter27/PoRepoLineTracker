@page "/diag"
@page "/diagnostics"
@inject RepoApiClient Api
@inject ILogger<Diagnostics> Logger
@using System.Diagnostics
@using PoRepoLineTracker.Client.Features.Shared
@using PoRepoLineTracker.Client.Models
@using Radzen
@using Radzen.Blazor

@* The fleet /diag page (standard of 2026-11-17). Reachable signed-out: no [Authorize], the
   server lets /diag through its production sign-in gate, and the data comes from the anonymous
   GET /api/diag, which carries statuses and fixed text only. /diagnostics is kept as an alias. *@

<PageTitle>System status · PoRepoLineTracker</PageTitle>

<div class="app-stack diag po-diag">
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.15rem">
                <h1 class="page-hero__title xc-title">System status</h1>
                <RadzenText TextStyle="TextStyle.Body2" class="xc-subtitle">
                    Whether the app, its storage and the services it relies on are working right now
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            <RadzenButton Text="Refresh" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined" Size="ButtonSize.Small"
                          IsBusy="@_isLoading" BusyText="Checking…"
                          Click="@LoadAsync" Disabled="@_isLoading" class="diag-refresh" />
        </Actions>
    </PageHero>

    @if (_report is null && _isLoading)
    {
        <RadzenCard>
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Body2">Running the checks…</RadzenText>
                <RadzenSkeleton Width="100%" Height="160px" />
            </RadzenStack>
        </RadzenCard>
    }
    else if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false" class="diag-banner">
            <strong>The server did not answer.</strong> @_error
        </RadzenAlert>
        <section class="po-diag__group xc-env-card" aria-labelledby="diag-api">
            <h2 id="diag-api" class="diag-section-title">API</h2>
            <div class="po-diag__card">
                <h3 class="diag-check__name">Server</h3>
                <span class="po-badge po-badge--bad">Unreachable</span>
                <span class="diag-check__note">Tried for @Ms(_apiMs)</span>
            </div>
        </section>
    }
    else if (_report is not null)
    {
        <RadzenAlert AlertStyle="@AlertFor(_report.Status)" ShowIcon="true" AllowClose="false" class="diag-banner"
                     data-status="@_report.Status">
            <strong>@Headline(_report.Status)</strong>
            <span class="diag-meta">
                @_report.Environment · version v@(_report.Version) ·
                <span title="@_report.CheckedAtUtc.ToLocalTime().ToString("f")">checked @ChartFormat.RelativeTime(_report.CheckedAtUtc)</span>
            </span>
        </RadzenAlert>

        <section class="po-diag__group xc-env-card" aria-labelledby="diag-api">
            <h2 id="diag-api" class="diag-section-title">API</h2>
            <div class="po-diag__card">
                <h3 class="diag-check__name">Server</h3>
                <span class="po-badge po-badge--ok">Reachable</span>
                <span class="diag-check__note">The app's own server, which this page just called. Responded in @Ms(_apiMs).</span>
            </div>
        </section>

        <section class="po-diag__group diag-section" aria-labelledby="diag-storage">
            <h2 id="diag-storage" class="diag-section-title">Data</h2>
            @CheckList(_report.Storage, "No data stores are checked by this server.")
        </section>

        <section class="po-diag__group diag-section" aria-labelledby="diag-services">
            <h2 id="diag-services" class="diag-section-title">Services</h2>
            @CheckList(_report.Services, "No external services are checked by this server.")
        </section>
    }
</div>

@code {
    private DiagnosticsResponse? _report;
    private bool _isLoading;
    private string? _error;
    private double _apiMs;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        if (_isLoading) return; // busy guard: the button is disabled too, this covers a double tap
        _isLoading = true;
        _error = null;
        var watch = Stopwatch.StartNew();
        try
        {
            _report = await Api.GetDiagnosticsAsync();
            if (_report is null) _error = "It returned an empty answer.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading diagnostics");
            _error = "Check your connection and press Refresh.";
            _report = null;
        }
        finally
        {
            _apiMs = watch.Elapsed.TotalMilliseconds;
            _isLoading = false;
        }
    }

    private RenderFragment CheckList(List<DiagnosticsCheck> checks, string empty) => __builder =>
    {
        if (checks.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="xc-subtitle">@empty</RadzenText>
            return;
        }
        <div class="diag-grid">
            @foreach (var check in checks)
            {
                @* One Po card per dependency: name and status badge on the first row, then what it is for. *@
                <div class="po-diag__card diag-check" data-check="@check.Name">
                    <h3 class="diag-check__name">@check.Name</h3>
                    <span class="po-badge po-badge--@BadgeFor(check.Status)">@check.Status</span>
                    <span class="diag-check__body">
                        @check.Purpose
                        @if (check.Note is not null)
                        {
                            <span class="diag-check__note">@check.Note@(check.ErrorType is null ? "" : $" ({check.ErrorType})")</span>
                        }
                        <span class="xc-caption">
                            @(check.LatencyMs is { } ms ? $"Checked in {Ms(ms)}" : "Configuration check, no call made")
                            · @ChartFormat.RelativeTime(_report!.CheckedAtUtc)
                        </span>
                    </span>
                </div>
            }
        </div>
    };

    private static string Ms(double ms) => ms < 1 ? "under 1 ms" : $"{ms:0} ms";

    private static string Headline(string status) => status switch
    {
        "Healthy" => "Everything is working.",
        "Degraded" => "Working, with warnings below.",
        _ => "Something is not working.",
    };

    private static AlertStyle AlertFor(string status) => status switch
    {
        "Healthy" => AlertStyle.Success,
        "Degraded" => AlertStyle.Warning,
        _ => AlertStyle.Danger,
    };

    private static string BadgeFor(string status) => status switch
    {
        "Healthy" => "ok",
        "Degraded" => "warn",
        _ => "bad",
    };
}
