@inject IJSRuntime JS

@* A number on a mechanical odometer: each digit is a reel of 0-9 that rolls to its new place when
   the value changes, the units first and each place to its left a beat later, the way a carry
   travels through real wheels (styles: .odo in effects.css). A change also clicks once per digit
   that moved, and crossing a power of ten from 1,000 up fires a milestone (js/fx.js).

   The first value an instance sees is simply shown: a tile appearing for the first time states its
   number rather than rolling up to it. RollIn is the exception, for a page whose entrance is the
   point (Year in Review): the reels start at zero and roll up once painted. Reduced motion needs nothing here: app.css zeroes every
   transition, so the reels jump. The reels are aria-hidden and the plain value beside them is
   what a screen reader (and a copy) gets. *@
<span class="odo @Class" @ref="_root">
    <span class="odo__value">@_text</span>
    <span class="odo__reels" aria-hidden="true">
        @for (var i = 0; i < _text.Length; i++)
        {
            // Keyed by place from the right, so 999 → 1,000 rolls the existing three reels and
            // adds the new ones on the left, instead of re-keying every digit.
            var place = _text.Length - i;
            var c = _text[i];
            if (char.IsAsciiDigit(c))
            {
                <span class="odo__reel" @key="place" style="--d:@c;--p:@place"><span class="odo__strip">0123456789</span></span>
            }
            else
            {
                <span class="odo__sep" @key="-place">@c</span>
            }
        }
    </span>
</span>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public string Format { get; set; } = "N0";
    [Parameter] public string? Class { get; set; }

    /// <summary>Roll up from zero on first appearance instead of stating the value.</summary>
    [Parameter] public bool RollIn { get; set; }

    private string _text = string.Empty;
    private int? _shown;
    private bool _rollPending;
    private ElementReference _root;

    protected override async Task OnParametersSetAsync()
    {
        var previous = _shown;
        var text = Value.ToString(Format);
        _shown = Value;
        if (previous is null)
        {
            _rollPending = RollIn;
            _text = RollIn ? new string(text.Select(c => char.IsAsciiDigit(c) ? '0' : c).ToArray()) : text;
            return;
        }

        // Mid-roll-in the reels are about to land on the latest value anyway; no clicks for it.
        if (_rollPending || text == _text) return;

        var changed = ChangedDigits(_text, text);
        _text = text;

        // Decoration: an interop failure (prerendering, teardown) costs the click, nothing else.
        try { await JS.InvokeVoidAsync("fx.odometer", _root, changed, CrossedMilestone(previous.Value, Value)); }
        catch (Exception) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_rollPending) return;

        // A beat for the zeros to paint first: a style set in the same frame an element appears in
        // has nothing to transition from.
        await Task.Delay(350);
        _rollPending = false;
        _text = Value.ToString(Format);
        StateHasChanged();
    }

    /// <summary>Digits that differ between two renderings, compared from the right as the reels are keyed.</summary>
    public static int ChangedDigits(string before, string after)
    {
        var changed = 0;
        for (var i = 1; i <= Math.Max(before.Length, after.Length); i++)
        {
            var a = i <= before.Length ? before[^i] : ' ';
            var b = i <= after.Length ? after[^i] : ' ';
            if (a != b && (char.IsAsciiDigit(a) || char.IsAsciiDigit(b))) changed++;
        }
        return changed;
    }

    /// <summary>True when a rise passes 1,000, 10,000, 100,000 and so on.</summary>
    public static bool CrossedMilestone(int before, int after)
    {
        if (after <= before || after < 1000) return false;
        for (long m = 1000; m <= after; m *= 10)
            if (before < m) return true;
        return false;
    }
}
