@* Page title strip: heading on the left, actions on the right, stacking on narrow containers.

   Repositories.razor and RepositoryDetail.razor carried the same Size="12" SizeMD="8" / "4"
   row with a right-aligned action stack. Both also pinned the action column to
   `rz-text-align-end` at every width, so on a phone the buttons stayed jammed against the right
   edge under a left-aligned title; here they go full-width instead.

   The RadzenRow/RadzenColumn split it used to use is gone — see PageHero.razor.css for why a
   12-column grid was the wrong tool for a two-item row. *@

<div class="page-hero">
    <div class="page-hero__row">
        <div class="page-hero__heading">@Heading</div>
        @if (Actions is not null)
        {
            <div class="page-hero__actions">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment? Heading { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
