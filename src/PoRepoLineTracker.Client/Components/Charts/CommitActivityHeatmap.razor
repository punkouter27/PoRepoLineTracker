@using PoRepoLineTracker.Client.Components.Shared
@using PoRepoLineTracker.Client.Services
@using PoRepoLineTracker.Shared.Domain
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Serialization
@using Radzen
@using Radzen.Blazor
@inject HttpClient Http
@inject ILogger<CommitActivityHeatmap> Logger
@implements IAsyncDisposable

<ChartCard Title="Activity Rhythm"
           Description="Commit density by day of week and hour"
           IsLoading="@_isLoading"
           ErrorMessage="@_error"
           OnRetry="@LoadDataAsync"
           IsEmpty="@(!_hasActivity)"
           EmptyIcon="schedule"
           EmptyText="No commit activity in this time range."
           EmptyHint="Expand the chart range selector above to look back further.">
    <ChildContent>
        <div class="rhythm-wrap">
            <!-- Hour headers -->
            <div class="rhythm-header">
                <div class="rhythm-day-label-space"></div>
                <div class="rhythm-hours">
                    @for (int h = 0; h < 24; h += 3)
                    {
                        <span class="rhythm-hour-mark" style="@($"left: {(h / 24.0 * 100):F1}%")">
                            @(FormatHour(h))
                        </span>
                    }
                </div>
            </div>

            <!-- 7-day grid -->
            @* role="img" with one summary, not role="grid". A grid promises cell-by-cell keyboard
               navigation; this had 168 gridcells and not one of them focusable, so a screen
               reader announced an interactive table that could not be entered. The per-cell
               detail stays on `title` for the pointer. *@
            <div class="rhythm-grid" role="img" aria-label="@Summary">
                @for (int d = 0; d < 7; d++)
                {
                    var dayIndex = d;
                    <div class="rhythm-row">
                        <span class="rhythm-day-label">@DayNames[dayIndex]</span>
                        <div class="rhythm-cells">
                            @for (int h = 0; h < 24; h++)
                            {
                                var hour = h;
                                var cell = GetCell(dayIndex, hour);
                                var intensity = GetIntensity(cell?.CommitCount ?? 0);
                                var tooltip = cell is not null && cell.CommitCount > 0
                                    ? $"{DayNames[dayIndex]} {FormatHour(hour)}: {cell.CommitCount} commits (+{cell.LinesAdded:N0} / -{cell.LinesRemoved:N0})"
                                    : $"{DayNames[dayIndex]} {FormatHour(hour)}: No commits";

                                <div class="rhythm-cell @(intensity > 0 ? "rhythm-cell--active" : "")"
                                     style="@($"--intensity: {intensity:F2}")"
                                     title="@tooltip">
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (_peakSlot is not null && _peakSlot.CommitCount > 0)
            {
                <div class="rhythm-footer">
                    <RadzenIcon Icon="bolt" class="rhythm-footer__icon" />
                    <span class="rhythm-footer__text">
                        Peak coding rhythm: <strong>@DayNames[_peakSlot.DayOfWeek]s around @FormatHour(_peakSlot.HourOfDay)</strong> (@_peakSlot.CommitCount commits)
                    </span>
                </div>
            }
        </div>
    </ChildContent>
</ChartCard>

@code {
    [Parameter] public RepositoryId RepositoryId { get; set; }
    [Parameter] public int Days { get; set; } = ChartFormat.DefaultRangeDays;

    private static readonly string[] DayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private List<PunchcardItemDto>? _items;
    private bool _isLoading;
    private string _error = string.Empty;
    private int _loadedDays = -1;
    private bool _disposed;
    private bool _hasActivity;
    private int _maxCommits;
    private PunchcardItemDto? _peakSlot;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedDays == Days) return;
        _loadedDays = Days;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (_disposed) return;
        _isLoading = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            _items = await Http.GetAppJsonAsync(
                $"/api/repositories/{RepositoryId}/punchcard/{Days}",
                AppJsonSerializerContext.Default.ListPunchcardItemDto);

            _maxCommits = _items?.Max(i => i.CommitCount) ?? 0;
            _hasActivity = _maxCommits > 0;
            _peakSlot = _items?.OrderByDescending(i => i.CommitCount).FirstOrDefault();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading commit punchcard for repository {RepositoryId}", RepositoryId);
            _error = $"Could not load activity rhythm: {ex.Message}";
        }
        finally
        {
            if (!_disposed)
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private string Summary =>
        "Commit activity by weekday and hour" + (_peakSlot is { CommitCount: > 0 } peak
            ? $". Busiest: {DayNames[peak.DayOfWeek]}s around {FormatHour(peak.HourOfDay)}, {peak.CommitCount} commits."
            : ".");

    private PunchcardItemDto? GetCell(int day, int hour) =>
        _items?.FirstOrDefault(i => i.DayOfWeek == day && i.HourOfDay == hour);

    private double GetIntensity(int count)
    {
        if (count <= 0 || _maxCommits <= 0) return 0;
        return Math.Max(0.2, (double)count / _maxCommits);
    }

    private static string FormatHour(int hour)
    {
        if (hour == 0) return "12 AM";
        if (hour == 12) return "12 PM";
        return hour < 12 ? $"{hour} AM" : $"{hour - 12} PM";
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return ValueTask.CompletedTask;
    }
}

