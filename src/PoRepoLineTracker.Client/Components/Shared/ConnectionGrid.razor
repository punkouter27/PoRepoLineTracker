@* One provider's external-dependency table on the /diagnostics page.

   ExternalConnections.razor carried this same card + heading + four-column grid three times over
   (Azure, GitHub, OpenTelemetry) — identical apart from the icon, the title, the bound list, and
   one predicate deciding whether a Status reads as healthy. ~60 lines of duplication in which a
   fix applied to one copy silently missed the other two.

   StatusIsHealthy is a parameter rather than a hardcoded `Status == "Configured"` because the
   GitHub row reports "PAT Configured" / "Rate Limited" instead, and that difference was the only
   real variation between the three blocks. *@

<RadzenCard>
    <RadzenStack Gap="1rem">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <RadzenIcon Icon="@Icon" class="@($"xc-icon {IconClass}")" />
            <RadzenText TextStyle="TextStyle.H6" class="xc-section-title">@Title</RadzenText>
        </RadzenStack>

        <div class="u-scroll-x">
            <RadzenDataGrid Data="@Connections" TItem="ExternalConnectionInfo" Responsive="true" class="xc-grid">
                <Columns>
                    <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Name" Title="Service" Width="25%" />
                    <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Type" Title="Type" Width="15%" />
                    <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Status" Title="Status" Width="15%">
                        <Template Context="data">
                            <RadzenBadge BadgeStyle="@(StatusIsHealthy(data.Status) ? BadgeStyle.Success : BadgeStyle.Warning)"
                                         Text="@data.Status" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ExternalConnectionInfo" Property="Purpose" Title="Purpose" Width="45%" />
                </Columns>
            </RadzenDataGrid>
        </div>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    /// <summary>Modifier class carrying the provider's brand colour, e.g. <c>xc-icon--azure</c>.</summary>
    [Parameter] public string? IconClass { get; set; }

    [Parameter, EditorRequired] public IEnumerable<ExternalConnectionInfo> Connections { get; set; } = [];

    /// <summary>
    /// Decides whether a Status string should render as success rather than warning. Defaults to
    /// an exact "Configured" match, which is what two of the three providers report.
    /// </summary>
    [Parameter] public Func<string, bool> StatusIsHealthy { get; set; } = static s => s == "Configured";
}
