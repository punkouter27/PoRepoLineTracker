@inject HttpClient Http
@inject ILogger<DigestBanner> Logger
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Serialization
@using Radzen
@using Radzen.Blazor

@* "Here is what happened while you were away."

   The one thing on the landing page that rewards coming back rather than merely reporting state.
   Everything else answers "how big is my code"; this answers "did anything change since I last
   looked", which is the only question a returning user actually arrives with.

   Renders nothing at all when there is nothing to say — no activity, a failed fetch, or a window
   the server declined to treat as a real absence. A banner that appears every load saying "0
   commits" trains people to ignore the space it occupies. *@

@* Plain <div> root so this file's scoped rules have something carrying the scope id to hang off,
   and so ::deep can reach into the Radzen card. Rooting at <RadzenCard> would compile every rule
   below against an attribute no element has — a failure this codebase has shipped more than once. *@
@if (_digest is { HasActivity: true } digest && !_dismissed)
{
    <div class="digest">
        <RadzenCard class="digest__card u-glass u-enter">
            <div class="digest__head">
                <div class="digest__title-group">
                    <RadzenIcon Icon="waving_hand" class="digest__icon" />
                    <div class="digest__titles">
                        <RadzenText TextStyle="TextStyle.H6" class="digest__title">@Headline(digest)</RadzenText>
                        <RadzenText TextStyle="TextStyle.Caption" class="digest__window">@WindowLabel(digest)</RadzenText>
                    </div>
                </div>
                <RadzenButton Icon="close"
                              ButtonStyle="ButtonStyle.Light"
                              Variant="Variant.Text"
                              Size="ButtonSize.Small"
                              class="digest__close"
                              title="Dismiss"
                              aria-label="Dismiss digest"
                              Click="@(() => _dismissed = true)" />
            </div>

            <div class="digest__stats">
                @* Commits and lines lead because they are what moved; the streak is last because
                   it is a standing figure the Insights page also carries. *@
                <div class="digest__stat">
                    <span class="digest__stat-value">@digest.Commits.ToString("N0")</span>
                    <span class="digest__stat-label">@(digest.Commits == 1 ? "commit" : "commits")</span>
                    @if (CommitTrend(digest) is { } trend)
                    {
                        <span class="@($"digest__trend digest__trend--{(trend.Up ? "up" : "down")}")">@trend.Label</span>
                    }
                </div>

                <div class="digest__stat">
                    <span class="digest__stat-value">+@digest.LinesAdded.ToString("N0")</span>
                    <span class="digest__stat-label">lines added</span>
                </div>

                @* Net growth is the snapshot difference, not added-minus-removed — the two differ
                   whenever a line was written and rewritten inside the window. Signed explicitly so
                   a shrinking portfolio reads as a deliberate figure rather than a missing minus. *@
                <div class="digest__stat">
                    <span class="@($"digest__stat-value digest__stat-value--{(digest.NetGrowth < 0 ? "neg" : "pos")}")">
                        @(digest.NetGrowth >= 0 ? "+" : "")@digest.NetGrowth.ToString("N0")
                    </span>
                    <span class="digest__stat-label">net</span>
                </div>

                <div class="digest__stat">
                    <span class="digest__stat-value">@digest.ReposTouched.ToString("N0")</span>
                    <span class="digest__stat-label">@(digest.ReposTouched == 1 ? "repo" : "repos")</span>
                </div>

                @if (digest.CurrentStreakDays > 0)
                {
                    <div class="digest__stat">
                        <span class="digest__stat-value"><span class="u-flame" style="--flame:@ChartFormat.StreakFlame(digest.CurrentStreakDays)" aria-hidden="true"></span>@digest.CurrentStreakDays.ToString("N0")</span>
                        <span class="digest__stat-label">day streak</span>
                    </div>
                }
            </div>

            @if (digest.TopRepos.Count > 0)
            {
                <div class="digest__repos">
                    <span class="digest__repos-label">Busiest:</span>
                    @foreach (var repo in digest.TopRepos)
                    {
                        <a class="digest__repo" href="@($"/repositories/{repo.RepositoryId}")">
                            <span class="digest__repo-name" title="@repo.Name">@repo.Name</span>
                            <span class="digest__repo-count">@repo.Commits</span>
                        </a>
                    }
                </div>
            }
        </RadzenCard>
    </div>
}

@code {
    private WeeklyDigestDto? _digest;
    private bool _dismissed;

    /// <summary>
    /// Guards the "mark seen" write. The component can re-render many times per second while an
    /// analysis is streaming into the page around it, and the visit must be recorded once.
    /// </summary>
    private bool _visitRecorded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _digest = await Http.GetAppJsonAsync("/api/insights/digest", AppJsonSerializerContext.Default.WeeklyDigestDto);
        }
        catch (Exception ex)
        {
            // A digest that cannot be fetched is not an error worth putting on screen: the page it
            // sits on works without it, and an alert about a decorative banner would be noisier
            // than the banner it replaces.
            Logger.LogWarning(ex, "Digest unavailable — banner not shown");
        }
    }

    /// <summary>
    /// Records the visit only AFTER a banner has actually rendered.
    ///
    /// <para>The read and the write are separate calls precisely so this ordering is possible. If
    /// fetching the digest also stamped the visit, a page opened and closed without the user
    /// looking would consume the window, and the next real visit would report nothing.</para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_visitRecorded || _digest is not { HasActivity: true }) return;

        _visitRecorded = true;

        try
        {
            // No body, and no JSON helper needed. The named "Api" client routes through
            // AntiforgeryHandler, which attaches the CSRF token every write under /api requires.
            using var response = await Http.PostAsync("/api/insights/digest/seen", content: null);
            if (!response.IsSuccessStatusCode)
                Logger.LogWarning("Marking digest seen returned {Status}", response.StatusCode);
        }
        catch (Exception ex)
        {
            // Failing to record the visit means the next digest covers a slightly longer window.
            // That is a strictly better failure than blocking the page on it.
            Logger.LogWarning(ex, "Could not record digest visit");
        }
    }

    /// <summary>
    /// The two headlines are different claims, so only the server's own verdict picks between
    /// them — see <see cref="WeeklyDigestDto.IsSinceLastVisit"/>. Guessing from the timestamps
    /// here would put the label out of step with the window the figures were actually built over.
    /// </summary>
    private static string Headline(WeeklyDigestDto digest) =>
        digest.IsSinceLastVisit ? "While you were away" : "Your week in code";

    private static string WindowLabel(WeeklyDigestDto digest)
    {
        var span = digest.UntilUtc - digest.SinceUtc;
        var wholeDays = (int)span.TotalDays;
        var length = wholeDays >= 1
            ? $"{wholeDays} {(wholeDays == 1 ? "day" : "days")}"
            : $"{Math.Max(1, (int)span.TotalHours)} hours";

        var activeDays = $"active on {digest.ActiveDays} {(digest.ActiveDays == 1 ? "day" : "days")}";

        return digest.IsSinceLastVisit
            ? $"Since your last visit {length} ago · {activeDays}"
            : $"Last {length} · {activeDays}";
    }

    /// <summary>
    /// Comparison against the equally-long window before this one. Null when there is nothing to
    /// compare against — "up from 0" is arithmetic, not news, and printing it on every first-ever
    /// digest would make the trend marker meaningless.
    /// </summary>
    private static (bool Up, string Label)? CommitTrend(WeeklyDigestDto digest)
    {
        if (digest.PreviousCommits <= 0 || digest.Commits == digest.PreviousCommits) return null;

        var delta = digest.Commits - digest.PreviousCommits;
        return (delta > 0, $"{(delta > 0 ? "▲" : "▼")} {Math.Abs(delta):N0} vs prior");
    }
}
