@inject HttpClient Http
@inject ILogger<PortfolioOverview> Logger

@if (_state is LoadingState<PortfolioInsightsDto>.Loading)
{
    <div class="app-dashboard app-dashboard--tiles">
        @for (var i = 0; i < 3; i++) { <RadzenCard><RadzenSkeleton Width="100%" Height="72px" /></RadzenCard> }
    </div>
    <RadzenCard><RadzenSkeleton Width="100%" Height="220px" /></RadzenCard>
}
else if (_state is LoadingState<PortfolioInsightsDto>.Failed failed)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">
        @failed.Message <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text" Click="@LoadAsync" />
    </RadzenAlert>
}
else if (_state is LoadingState<PortfolioInsightsDto>.Loaded { Value: { } data })
{
    <div class="app-dashboard app-dashboard--tiles">
        <KpiTile Label="Total lines" Delta="@($"+{data.LinesAddedAllTime:N0} written")" Sub="@($"−{data.LinesRemovedAllTime:N0} removed")" DeltaClass="kpi__delta--pos">@data.TotalLines.ToString("N0")</KpiTile>
        <KpiTile Label="Commits" Delta="@($"across {data.ActiveDaysAllTime:N0} active days")">@data.CommitsAllTime.ToString("N0")</KpiTile>
        <KpiTile Label="Current streak" Unit="d" Delta="@($"best {data.LongestStreakDays} d ever")">@data.CurrentStreakDays</KpiTile>
    </div>
    <div class="app-dashboard app-dashboard--panels">
        <ChartCard Title="Portfolio growth" Description="Total lines across every repository, all time" IsEmpty="@(data.TrendLine.Count == 0)">
            <RadzenChart>
                <RadzenAreaSeries Data="@data.TrendLine" CategoryProperty="Date" ValueProperty="TotalLines" Title="Total lines"
                                  Stroke="var(--rz-primary)" Fill="color-mix(in srgb, var(--primary-color) 14%, transparent)" StrokeWidth="3" />
                <RadzenCategoryAxis FormatString="{0:MMM yyyy}" Step="@ChartFormat.DateAxisStep(data.TrendLine.Select(p => p.Date))" LabelAutoRotation="-45"><RadzenGridLines Visible="true" /></RadzenCategoryAxis>
                <RadzenValueAxis Min="0" Formatter="@ChartFormat.Lines"><RadzenGridLines Visible="true" /></RadzenValueAxis>
                <RadzenLegend Visible="false" />
            </RadzenChart>
        </ChartCard>
        <ExtensionBreakdownCard Title="Language mix" Description="Share of current lines by file type"
                                Extensions="@(data.LanguageMix.Select(l => new FileExtensionPercentageDto { FileExtension = l.Extension, Percentage = l.Percentage, LineCount = l.Lines }).ToList())" />
    </div>
    <ChartCard Title="Activity" Description="Commits per day across every tracked repository, all time" IsEmpty="@(data.Activity.Count == 0)">
        <div class="u-scroll-x"><div class="ins-heat ins-heat--dense" role="img" aria-label="@($"{data.Activity.Count(d => d.Commits > 0)} active days, {data.Activity.Sum(d => d.Commits):N0} commits")">
            @for (var i = 0; i < LeadingBlanks(data); i++) { <span class="ins-heat__cell ins-heat--blank"></span> }
            @foreach (var day in data.Activity) { <span class="ins-heat__cell @IntensityClass(day.Commits)" title="@($"{day.Date:MMM d, yyyy} — {day.Commits} commits")"></span> }
        </div></div>
    </ChartCard>
}

@code {
    private LoadingState<PortfolioInsightsDto> _state = new LoadingState<PortfolioInsightsDto>.Loading();
    protected override Task OnInitializedAsync() => LoadAsync();
    private static int LeadingBlanks(PortfolioInsightsDto data) => data.Activity.Count > 0 ? (int)data.Activity[0].Date.DayOfWeek : 0;
    private static string IntensityClass(int commits) => commits switch { 0 => "ins-heat--0", <= 2 => "ins-heat--1", <= 5 => "ins-heat--2", <= 10 => "ins-heat--3", _ => "ins-heat--4" };

    private async Task LoadAsync()
    {
        _state = new LoadingState<PortfolioInsightsDto>.Loading();
        try
        {
            var data = await Http.GetAppJsonAsync("/api/insights/portfolio", AppJsonSerializerContext.Default.PortfolioInsightsDto);
            _state = data is null ? new LoadingState<PortfolioInsightsDto>.Failed("No portfolio data was returned.") : new LoadingState<PortfolioInsightsDto>.Loaded(data);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load portfolio overview");
            _state = new LoadingState<PortfolioInsightsDto>.Failed("Could not load portfolio insights. Please try again.");
        }
    }
}
