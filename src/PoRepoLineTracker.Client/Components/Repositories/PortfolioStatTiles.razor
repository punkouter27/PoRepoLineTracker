@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen
@using Radzen.Blazor

@* The three portfolio summary tiles above the repository grid.

   An auto-fit grid rather than a 3-column RadzenRow: the tiles reflow from 3 → 2 → 1 across the
   range on their own, without a breakpoint per step, and never leave a half-empty final row.

   Extracted from Repositories.razor, which was 1,200 lines and rendered the hero, the add panel,
   the onboarding state, the comparison chart, these tiles, a search bar, a six-column grid and all
   of the progress plumbing. Everything here is presentational — it takes numbers and draws them. *@

@* Through <KpiTile>, like the Insights row. These were a second tile design (`.stat-card`: icon,
   accent stripe, its own type scale) for the same "label + big number" job, so the two
   dashboards disagreed about what a tile looks like. *@
<div class="app-dashboard app-dashboard--tiles">
    <KpiTile Label="Repositories">
        @if (Loading)
        {
            <RadzenSkeleton Width="3ch" Height="1em" />
        }
        else
        {
            <AnimatedNumber Value="@RepositoryCount" />
        }
    </KpiTile>
    <KpiTile Label="Total Lines" data-fx="lines">
        @* Three states, not one number: a 0 while the request is still in flight read
           as "you have no code" for several seconds on every page load. *@
        @if (Loading || !TotalsLoaded)
        {
            <RadzenSkeleton Width="5ch" Height="1em" />
        }
        else if (TotalLines is { } totalLines)
        {
            <AnimatedNumber Value="@totalLines" />
        }
        else
        {
            <span>—</span>
        }
        @* The 365-day history is already in hand from LoadLatestLineCounts, so the
           trend costs no extra request. *@
        @if (Trend.Count > 1)
        {
            <div class="rp-stat-spark">
                <RadzenSparkline Data="@Trend"
                                 CategoryProperty="Date"
                                 ValueProperty="TotalLines"
                                 Stroke="var(--status-info)"
                                 Fill="color-mix(in srgb, var(--status-info) 16%, transparent)" />
            </div>
        }
    </KpiTile>
    <KpiTile Label="Analyzed">
        @if (Loading)
        {
            <RadzenSkeleton Width="3ch" Height="1em" />
        }
        else
        {
            <AnimatedNumber Value="@AnalyzedCount" />
        }
    </KpiTile>
</div>

@code {
    /// <summary>
    /// True while the repository list itself is loading. The page renders these tiles as its
    /// skeleton, so the row is already the right shape when the numbers arrive.
    /// </summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter] public int RepositoryCount { get; set; }

    /// <summary>
    /// Sum of every tracked repository's current size. See RepositoryTotals for the definition.
    /// Null when the totals could not be loaded — rendered as a dash, never as 0.
    /// </summary>
    [Parameter] public int? TotalLines { get; set; }

    /// <summary>False while the first totals request is in flight; the tile shows a skeleton.</summary>
    [Parameter] public bool TotalsLoaded { get; set; }

    [Parameter] public int AnalyzedCount { get; set; }

    /// <summary>
    /// Portfolio-wide daily totals for the sparkline. Comes from history the page already fetched
    /// for the figures above, so the trend costs no extra request.
    /// </summary>
    [Parameter] public IReadOnlyList<DailyLineCountDto> Trend { get; set; } = [];
}
