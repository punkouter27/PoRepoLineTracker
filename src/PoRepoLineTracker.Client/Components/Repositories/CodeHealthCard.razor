@inject HttpClient Http
@inject ILogger<CodeHealthCard> Logger
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Serialization
@using Radzen
@using Radzen.Blazor

@* Code health: a maintainability score for the repository as it stands, with the reasoning shown.

   Loaded with the page (owner, 2026-11-05), so the tab already shows its figures when opened. The
   report walks the whole HEAD tree — seconds on a large repository — but the request runs in the
   background while the other tabs paint, and the server memoises it per commit. The button re-runs. *@

@* Plain <div> root so this file's scoped rules have an element carrying the scope id, and so
   ::deep can reach into what Radzen renders. *@
<div class="health">
    <RadzenCard class="health__card">
        <div class="health__head">
            <div class="health__title-group">
                <RadzenIcon Icon="health_and_safety" class="health__icon" />
                <div>
                    <RadzenText TextStyle="TextStyle.H6" class="health__title">Code health</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="health__sub">
                        @if (_report is { HasData: true } loaded)
                        {
                            <span>Static analysis of @loaded.FilesAnalyzed.ToString("N0") files at @loaded.CommitSha</span>
                        }
                        else
                        {
                            <span>Maintainability score from static analysis of the current source</span>
                        }
                    </RadzenText>
                </div>
            </div>

            <RadzenButton Text="@(_report is null ? "Analyze" : "Re-run")"
                          Icon="@(_isLoading ? "hourglass_top" : "insights")"
                          ButtonStyle="ButtonStyle.Secondary"
                          Variant="Variant.Outlined"
                          Size="ButtonSize.Small"
                          Disabled="@_isLoading"
                          Click="@LoadAsync" />
        </div>

        @if (_isLoading)
        {
            <RadzenStack Gap="0.75rem">
                <RadzenSkeleton Width="180px" Height="48px" />
                <RadzenSkeleton Height="80px" />
            </RadzenStack>
        }
        else if (!string.IsNullOrEmpty(_message))
        {
            <RadzenText TextStyle="TextStyle.Body2" class="health__message">@_message</RadzenText>
        }
        else if (_report is { HasData: true } report)
        {
            <div class="health__summary">
                <div class="@($"health__grade health__grade--{report.Grade.ToLowerInvariant()}")">
                    <span class="health__grade-letter">@report.Grade</span>
                    <span class="health__grade-score">@report.Score / 100</span>
                </div>

                <div class="health__totals">
                    <div class="health__total">
                        <span class="health__total-value">@report.CodeLines.ToString("N0")</span>
                        <span class="health__total-label">code lines</span>
                    </div>
                    <div class="health__total">
                        <span class="health__total-value">@report.TotalComplexity.ToString("N0")</span>
                        <span class="health__total-label">decision points</span>
                    </div>
                    <div class="health__total">
                        <span class="health__total-value">@report.DebtMarkers.ToString("N0")</span>
                        <span class="health__total-label">debt markers</span>
                    </div>
                </div>
            </div>

            @* Radar chart visualization of technical debt shape *@
            <CodeHealthRadar Factors="@report.Factors" />

            @* Each factor shows its own bar, its raw measurement and its weight. A single score
               with no breakdown is not actionable, and an unexplained score invites the reader to
               assume it measures something it does not. *@
            <div class="health__factors">
                @foreach (var factor in report.Factors)
                {
                    <div class="health__factor" title="@factor.Explanation">
                        <div class="health__factor-head">
                            <span class="health__factor-name">@factor.Name</span>
                            <span class="health__factor-weight">@factor.Weight pts</span>
                            <span class="@($"health__factor-score health__factor-score--{Band(factor.Score)}")">@factor.Score</span>
                        </div>
                        <div class="health__bar-track">
                            <div class="@($"health__bar health__bar--{Band(factor.Score)}")" style="@($"--bar: {factor.Score}%")"></div>
                        </div>
                        <span class="health__factor-measure">@factor.Measurement</span>
                    </div>
                }
            </div>

            @if (report.Hotspots.Count > 0)
            {
                <div class="health__hotspots">
                    <span class="health__section-label">Worth looking at first</span>
                    @foreach (var file in report.Hotspots)
                    {
                        <div class="health__hotspot">
                            <code class="health__hotspot-path" title="@file.Path">@file.Path</code>
                            <span class="health__hotspot-concern">@file.PrimaryConcern</span>
                            <span class="health__hotspot-meta">@file.CodeLines.ToString("N0") lines · depth @file.NestingDepth · cc @file.CyclomaticComplexity</span>
                            <span class="@($"health__factor-score health__factor-score--{Band(file.Score)}")">@file.Score</span>
                        </div>
                    }
                </div>
            }

            @if (report.ByLanguage.Count > 1)
            {
                <div class="health__languages">
                    <span class="health__section-label">By language</span>
                    <div class="health__language-row">
                        @foreach (var language in report.ByLanguage)
                        {
                            <span class="health__language" title="@($"{language.Files:N0} files, {language.CodeLines:N0} code lines")">
                                <code>@language.Extension</code>
                                <span class="@($"health__factor-score health__factor-score--{Band(language.Score)}")">@language.Score</span>
                            </span>
                        }
                    </div>
                </div>
            }

            @* The parsed C# figures, kept visually apart from the estimated ones above. These are
               the Code Metrics window's numbers, so they are stated as measurements rather than
               hedged the way the composite score has to be. *@
            @if (report.Metrics is { MembersMeasured: > 0 } metrics)
            {
                <div class="health__metrics">
                    <span class="health__section-label">C# code metrics — measured, not estimated</span>

                    <div class="health__totals">
                        <div class="health__total">
                            <span class="health__total-value">@(metrics.MaintainabilityIndex?.ToString() ?? "—")</span>
                            <span class="health__total-label">maintainability index</span>
                        </div>
                        <div class="health__total">
                            <span class="health__total-value">@metrics.CyclomaticComplexity.ToString("N0")</span>
                            <span class="health__total-label">cyclomatic complexity</span>
                        </div>
                        <div class="health__total">
                            <span class="health__total-value">@metrics.LinesOfSourceCode.ToString("N0")</span>
                            <span class="health__total-label">lines of source</span>
                        </div>
                        <div class="health__total">
                            <span class="health__total-value">@metrics.LinesOfExecutableCode.ToString("N0")</span>
                            <span class="health__total-label">lines executable</span>
                        </div>
                    </div>

                    @if (metrics.LeastMaintainable.Count > 0)
                    {
                        <span class="health__section-label">Least maintainable members</span>
                        @foreach (var member in metrics.LeastMaintainable)
                        {
                            <div class="health__hotspot">
                                <code class="health__hotspot-path" title="@($"{member.File} :: {member.Member}")">@member.Member</code>
                                <span class="health__hotspot-concern">@member.File</span>
                                <span class="health__hotspot-meta">@member.LinesOfCode.ToString("N0") lines · cc @member.CyclomaticComplexity</span>
                                <span class="@($"health__factor-score health__factor-score--{Band(member.MaintainabilityIndex)}")">@member.MaintainabilityIndex</span>
                            </div>
                        }
                    }

                    @* Named rather than silently absent: a reader who knows the Code Metrics window
                       will look for these two columns, and "missing" should not read as "zero". *@
                    <RadzenText TextStyle="TextStyle.Caption" class="health__caveat">
                        Parsed from @metrics.FilesAnalyzed.ToString("N0") C# files@(metrics.FilesSkipped > 0 ? $" ({metrics.FilesSkipped:N0} did not parse)" : "")
                        over @metrics.MembersMeasured.ToString("N0") members — the same quantities Visual Studio reports.
                        Depth of Inheritance and Class Coupling are not shown: both need a resolved compilation, which
                        means building the repository.
                    </RadzenText>
                </div>
            }

            @* Stated on the card, not buried in a tooltip. The score is a set of line-oriented
               proxies, not Visual Studio's parser-derived Maintainability Index, and presenting it
               without saying so would invite it to be trusted as more precise than it is. *@
            <RadzenText TextStyle="TextStyle.Caption" class="health__caveat">
                Line-oriented static analysis — branch density, nesting, file size, comments, debt markers
                and line length. An approximation, not a compiler: the ranking is more reliable than the
                absolute number.
            </RadzenText>
        }
    </RadzenCard>
</div>

@code {
    /// <summary>Repository to report on.</summary>
    [Parameter, EditorRequired] public RepositoryId RepositoryId { get; set; }

    private CodeHealthDto? _report;
    private bool _isLoading;
    private string _message = string.Empty;

    private RepositoryId? _loadedFor;

    /// <summary>On parameters rather than once: navigating between repositories reuses this component.</summary>
    protected override Task OnParametersSetAsync()
    {
        if (_loadedFor == RepositoryId) return Task.CompletedTask;
        _loadedFor = RepositoryId;
        _report = null;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            using var response = await Http.GetAsync($"/api/code-health/{RepositoryId}");

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                // The endpoint returns 404 specifically for "never analysed", which is a state to
                // explain rather than an error to report.
                _message = "No analysed commits yet — run an analysis on this repository first.";
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                _message = "Could not measure this repository. Try again in a moment.";
                return;
            }

            _report = await response.Content.ReadAppJsonAsync(AppJsonSerializerContext.Default.CodeHealthDto);

            if (_report is { HasData: false })
            {
                _message = "No counted source files found at the latest commit.";
                _report = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load code health for {RepositoryId}", RepositoryId);
            _message = "Could not measure this repository. Try again in a moment.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Colour band for a 0–100 score. Three bands rather than a gradient: the point is "fine /
    /// worth a look / deal with this", and a continuous ramp makes 71 and 69 look identical while
    /// implying a precision these figures do not have.
    /// </summary>
    private static string Band(int score) => score switch
    {
        >= 80 => "good",
        >= 60 => "warn",
        _ => "poor"
    };
}
