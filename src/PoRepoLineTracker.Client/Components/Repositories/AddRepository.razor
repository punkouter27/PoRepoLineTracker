@attribute [Authorize]
@inject HttpClient Http
@inject ILogger<AddRepository> Logger
@inject NavigationManager Navigation
@inject DialogService DialogService
@inject NotificationService NotificationService
@implements IAsyncDisposable
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Shared.Domain
@using PoRepoLineTracker.Shared.Models.Dtos
@using Radzen.Blazor
@using Microsoft.AspNetCore.Authorization
@using Radzen
@* The wrapper <div> is this component's CSS-isolation anchor for ::deep rules. *@
<div class="add-repo">
<RadzenStack Gap="1rem">
    @if (!string.IsNullOrEmpty(pageState.ErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" Variant="Variant.Flat"
                     Close="@(() => pageState.ErrorMessage = string.Empty)">
            @pageState.ErrorMessage
        </RadzenAlert>
    }

    @if (!string.IsNullOrEmpty(pageState.AddRepoMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Success" ShowIcon="true" Variant="Variant.Flat"
                     Close="@(() => pageState.AddRepoMessage = string.Empty)">
            @pageState.AddRepoMessage
        </RadzenAlert>
    }

    @if (pageState.IsLoadingGitHubRepos)
    {
        <RadzenCard class="add-repo-progress">
            <RadzenStack Gap="0.4rem">
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                                   aria-label="Fetching your GitHub repositories" />
                <RadzenText TextStyle="TextStyle.Caption" class="add-repo-progress-message">Fetching your GitHub repositories…</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
    else if (pageState.IsAddingRepository)
    {
        <RadzenCard class="add-repo-progress">
            <RadzenStack Gap="0.4rem">
                @* `Value` is int?, so the same RadzenProgressBar handles both determinate and
                   indeterminate. Mode=Indeterminate gives an honest "we don't know yet" bar
                   instead of a fake 0→100 snap. The text underneath stays current from
                   pageState.ProgressMessage and tells the user what is actually happening. *@
                @if (pageState.ProgressPercentage.HasValue)
                {
                    <RadzenProgressBar Value="@pageState.ProgressPercentage.Value"
                                        ShowValue="true"
                                        aria-label="@pageState.ProgressMessage" />
                }
                else
                {
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate"
                                        aria-label="@pageState.ProgressMessage" />
                }
                <RadzenText TextStyle="TextStyle.Caption" class="add-repo-progress-message">@pageState.ProgressMessage</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
</RadzenStack>
</div>
@code {
    private RepositoryPageState pageState = new();
    private CancellationTokenSource? _addCts;

    /// <summary>Hard ceiling on the bulk-add request. GitHub clones + line counting
    /// for big repos can take 30+ s; 60 s leaves headroom before we surface a timeout
    /// to the user instead of letting the spinner hang forever.</summary>
    private static readonly TimeSpan AddTimeout = TimeSpan.FromSeconds(60);

    public ValueTask DisposeAsync()
    {
        _addCts?.Cancel();
        _addCts?.Dispose();
        _addCts = null;
        return ValueTask.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        // One-click import: fetch the GitHub repo list and immediately queue every repo for
        // adding. The modal is a progress view, not a picker — there is no list and nothing to
        // confirm.
        await LoadGitHubRepositories();

        // Fetch failed: leave the modal up showing the error alert; the user closes it via X.
        if (!string.IsNullOrEmpty(pageState.ErrorMessage)) return;

        if (pageState.GitHubUserRepositories.Count == 0)
        {
            // Nothing on GitHub to import — close quietly; the page behind already shows what is
            // tracked.
            DialogService.Close(false);
            return;
        }

        _selected = pageState.GitHubUserRepositories;
        await AddSelectedRepositories();
    }

    private async Task LoadGitHubRepositories()
    {
        pageState.IsLoadingGitHubRepos = true;
        pageState.ErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync("/api/github/user-repositories");

            if (response.IsSuccessStatusCode)
            {
                var gitHubRepos = await response.Content.ReadAppJsonAsync(AppJsonSerializerContext.Default.ListGitHubUserRepositoryDto);
                var sorted = gitHubRepos?.OrderBy(r => r.Name).ToList() ?? new List<GitHubUserRepositoryDto>();
                pageState.GitHubUserRepositories = sorted;
                Logger.LogInformation("Loaded {Count} GitHub user repositories.", pageState.GitHubUserRepositories.Count);
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                Logger.LogWarning("Failed to load GitHub repositories: {StatusCode} - {ErrorMessage}", response.StatusCode, errorBody);
                var displayError = errorBody;
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(errorBody);
                    if (doc.RootElement.TryGetProperty("detail", out var detailElem) && !string.IsNullOrWhiteSpace(detailElem.GetString()))
                    {
                        displayError = detailElem.GetString()!;
                    }
                    else if (doc.RootElement.TryGetProperty("title", out var titleElem) && !string.IsNullOrWhiteSpace(titleElem.GetString()))
                    {
                        displayError = titleElem.GetString()!;
                    }
                }
                catch
                {
                    // If not JSON, use errorBody as-is
                }
                pageState.ErrorMessage = $"Unable to load repositories: {displayError}";
                pageState.GitHubUserRepositories = new List<GitHubUserRepositoryDto>();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading GitHub repositories: {Message}", ex.Message);
            pageState.ErrorMessage = $"Error loading GitHub repositories: {ex.Message}";
            pageState.GitHubUserRepositories = new List<GitHubUserRepositoryDto>();
        }
        finally
        {
            pageState.IsLoadingGitHubRepos = false;
            StateHasChanged();
        }
    }

    private IEnumerable<GitHubUserRepositoryDto> _selected = Enumerable.Empty<GitHubUserRepositoryDto>();

    private async Task AddSelectedRepositories()
    {
        if (pageState.IsAddingRepository || !_selected.Any()) return;

        pageState.IsAddingRepository = true;
        pageState.ClearMessages();
        StateHasChanged();

        // Cancel any prior in-flight request before issuing a new one.
        _addCts?.Cancel();
        _addCts?.Dispose();
        _addCts = new CancellationTokenSource(AddTimeout);

        var selectedCount = _selected.Count();
        // Indeterminate spinner (Value=null) is the right choice here: the POST is one round-trip
        // for the whole list and the per-repo work happens in the background analysis pipeline,
        // which the modal can only describe — not measure. Showing a "0/23" bar that snaps to
        // 23/23 in 800 ms was what the old 4-step fake progress did, and it lied about work
        // that hadn't started.
        pageState.SetProgress($"Adding {selectedCount} {(selectedCount == 1 ? "repository" : "repositories")}…", null);

        try
        {
            Logger.LogInformation("=== START AddSelectedRepositories ===");
            Logger.LogInformation("Number of selected repositories: {Count}", selectedCount);

            var selectedList = _selected.ToList();
            for (int i = 0; i < selectedList.Count; i++)
            {
                var repo = selectedList[i];
                Logger.LogInformation("Selected Repo [{Index}]: FullName='{FullName}'", i, repo.FullName);
            }

            var repositoriesToAdd = _selected.Select(repo =>
            {
                var fullNameParts = repo.FullName.Split('/', 2);
                if (fullNameParts.Length < 2)
                {
                    Logger.LogWarning("Unexpected FullName format '{FullName}' — expected 'owner/repo'", repo.FullName);
                    return new BulkRepositoryDto { Owner = repo.FullName, RepoName = repo.Name };
                }
                Logger.LogInformation("Splitting FullName '{FullName}' into Owner='{Owner}' and RepoName='{RepoName}'",
                    repo.FullName, fullNameParts[0], fullNameParts[1]);

                return new BulkRepositoryDto
                {
                    Owner = fullNameParts[0],
                    RepoName = fullNameParts[1]
                };
            }).ToList();

            Logger.LogInformation("Prepared {Count} repositories for API call", repositoriesToAdd.Count);

            for (int i = 0; i < repositoriesToAdd.Count; i++)
            {
                var repo = repositoriesToAdd[i];
                Logger.LogInformation("Sending Repo [{Index}]: Owner='{Owner}', RepoName='{RepoName}'",
                    i, repo.Owner, repo.RepoName);
            }

            Logger.LogInformation("Making POST request to /api/repositories/bulk with {Count} repositories", repositoriesToAdd.Count);
            var response = await Http.PostAppJsonAsync("/api/repositories/bulk", repositoriesToAdd,
                AppJsonSerializerContext.Default.ListBulkRepositoryDto, _addCts!.Token);

            Logger.LogInformation("Bulk repository add response: Status={StatusCode}", response.StatusCode);

            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation("Reading response content as JSON...");
                var bulkResult = await response.Content.ReadAppJsonAsync(AppJsonSerializerContext.Default.BulkAddResult);

                var addedCount = bulkResult?.Added.Count ?? 0;
                var alreadyTrackedCount = bulkResult?.AlreadyTracked.Count ?? 0;

                Logger.LogInformation("Bulk result: Added={Added}, AlreadyTracked={AlreadyTracked}", addedCount, alreadyTrackedCount);

                // Summary line on the modal. Reads the actual numbers from the response, not
                // "Complete!" — and tells the user the next thing that will happen, which is
                // background analysis on the newly-added repos.
                if (addedCount > 0 && alreadyTrackedCount == 0)
                {
                    pageState.AddRepoMessage = $"Added {addedCount} {(addedCount == 1 ? "repository" : "repositories")}. " +
                        $"Background analysis is queued — the page will refresh automatically.";
                }
                else if (addedCount > 0 && alreadyTrackedCount > 0)
                {
                    var alreadyNames = bulkResult!.AlreadyTracked.Select(r => $"{r.Owner}/{r.Name}");
                    pageState.AddRepoMessage = $"Added {addedCount} new; {alreadyTrackedCount} already tracked ({string.Join(", ", alreadyNames)}) — no changes to those. " +
                        $"Background analysis queued for the new ones.";
                }
                else if (alreadyTrackedCount > 0)
                {
                    var alreadyNames = bulkResult?.AlreadyTracked.Select(r => $"{r.Owner}/{r.Name}") ?? [];
                    pageState.AddRepoMessage = $"All {alreadyTrackedCount} selected {(alreadyTrackedCount == 1 ? "repository is" : "repositories are")} already tracked: {string.Join(", ", alreadyNames)}. " +
                        $"No new repositories were added.";
                }
                else
                {
                    pageState.AddRepoMessage = "No repositories added (server returned an empty result).";
                }

                // Hold the success line briefly so the user can read it before the dialog closes.
                // 1.2 s is enough to read two short sentences on the modal width without dragging.
                await Task.Delay(1200);

                _selected = Enumerable.Empty<GitHubUserRepositoryDto>();

                // Close with `true` so the parent page reloads the repository list and
                // prime-polls the analysis feed. Don't `Navigation.NavigateTo("/repositories")`
                // here — the modal is opened FROM /repositories, and a hard navigate tears down
                // the analysis feed's SignalR subscription mid-handshake, which is what was
                // surfacing as "no live progress after bulk-add" before.
                DialogService.Close(true);
            }
            else
            {
                pageState.SetProgress("Could not add repositories", null);
                StateHasChanged();

                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("Bulk repository add failed: Status={StatusCode}, Content={ErrorContent}", response.StatusCode, errorContent);
                // Bulk add is rate-limited per user. "429 Too Many Requests, check the logs" sends
                // the user looking for a fault that is not there.
                var rateLimited = response.StatusCode == System.Net.HttpStatusCode.TooManyRequests;
                pageState.ErrorMessage = rateLimited
                    ? "Too many requests, try again in a minute."
                    : $"Error adding repositories: {(int)response.StatusCode} {response.ReasonPhrase}";
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = rateLimited ? NotificationSeverity.Warning : NotificationSeverity.Error,
                    Summary = "Couldn't add repositories",
                    Detail = rateLimited
                        ? "Too many requests, try again in a minute."
                        : $"Server returned {(int)response.StatusCode} {response.ReasonPhrase}. Please try again or check the logs.",
                    Duration = 6000
                });
            }
        }
        catch (OperationCanceledException) when (_addCts?.IsCancellationRequested == true)
        {
            pageState.SetProgress("Timed out", 100);
            pageState.ErrorMessage = $"Adding repositories took longer than {(int)AddTimeout.TotalSeconds} seconds and was cancelled. The background analysis may still complete — refresh this page in a moment.";
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Add request timed out",
                Detail = $"We waited {(int)AddTimeout.TotalSeconds} s for a response. Analysis keeps running in the background — refresh to see results.",
                Duration = 7000
            });
            Logger.LogWarning("Bulk repository add timed out after {Timeout}", AddTimeout);
        }
        catch (Exception ex)
        {
            pageState.SetProgress("Error occurred", 100);
            pageState.ErrorMessage = $"Error adding repositories: {ex.Message}";
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Couldn't add repositories",
                Detail = ex.Message,
                Duration = 6000
            });
            Logger.LogError(ex, "Error adding repositories: {Message}", ex.Message);
        }
        finally
        {
            pageState.IsAddingRepository = false;
            pageState.ProgressMessage = string.Empty;
            pageState.ProgressPercentage = 0;
            StateHasChanged();
        }
    }
}

