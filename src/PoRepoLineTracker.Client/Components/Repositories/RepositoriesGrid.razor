@using PoRepoLineTracker.Client.Components.Shared
@using PoRepoLineTracker.Client.Models
@using PoRepoLineTracker.Shared.Models
@using PoRepoLineTracker.Shared.Models.Dtos
@using PoRepoLineTracker.Shared.Domain
@using Radzen
@using Radzen.Blazor
@inject IJSRuntime JS
@inject PoRepoLineTracker.Client.Services.AnalysisFeedClient Feed
@implements IDisposable

@*
  Repository grid. Extracted from Repositories.razor so the page can stay focused on
  state + plumbing; this component owns the markup and CSS class names for the
  columns (Repository / Total Lines / Net 30d / Commits 30d / Cadence / Last commit / Status /
  Actions).

  The three 30-day columns came from the Insights page's "All repositories" table, which was a
  second grid of the same rows: two places to look a repository up, sorted differently.

  The five-column layout matches Phase 3 pick A7 (single visual seam — tiles above,
  grid below). Phase 3 pick B1 supplies the page hero above the tiles.
*@

<div class="rp-grid-toolbar">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem" class="rz-mb-2">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.6rem">
            <RadzenText TextStyle="TextStyle.Subtitle1" class="rp-grid-heading">Tracked Repositories</RadzenText>
            @* Connection state of the live progress feed, shown only while a job is running — the
               rows' Status cells carry the progress itself (this used to be a separate "Live
               activity" panel above the grid that repeated each running row). A label beside the
               dot, because colour alone is not an accessible signal; the pulse only while really
               connected, or it would contradict "Reconnecting…". *@
            @if (AnyRunning)
            {
                <span class="rp-live-state" role="status">
                    <span class="@($"rp-live-dot {(Feed.IsConnected ? "rp-live-dot--on" : "")}")" aria-hidden="true"></span>
                    @(Feed.IsConnected ? "Streaming" : "Reconnecting…")
                </span>
            }
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem" class="rp-search-controls">
            <RadzenTextBox Value="@Search" ValueChanged="@SearchChanged"
                           Placeholder="Search repositories..."
                           aria-label="Filter repositories by name or owner"
                           class="rp-search-input" />
            @if (!string.IsNullOrEmpty(Search))
            {
                <RadzenButton Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                              Click="@(() => SearchChanged.InvokeAsync(string.Empty))" title="Clear search" aria-label="Clear search" />
            }
            @* The table sorts from its column headers and filters from the funnel on each of
               them, so these two controls are only here for the card list below 768px —
               custom markup with no header row to click. Hidden from the table view by CSS.
               Both write the same _sortProperty the grid's own Sort event writes, so the two
               views never disagree about which column is sorted. *@
            <div class="rp-sort-controls">
                <label class="rp-sort-label"><span class="rz-helper-hidden-accessible">Sort repositories</span>
                    <select class="rz-inputtext rp-sort" value="@_sortProperty" @onchange="@(args => OnSortSelected(args.Value?.ToString() ?? "Name"))">
                        @foreach (var option in SortOptions) { <option value="@option.Value">@option.Label</option> }
                    </select>
                </label>
                <RadzenButton Icon="@(_sortDescending ? "arrow_downward" : "arrow_upward")" Size="ButtonSize.Small"
                              ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" Click="@ToggleSortDirection"
                              title="@(_sortDescending ? "Sort ascending" : "Sort descending")"
                              aria-label="@(_sortDescending ? "Sort ascending" : "Sort descending")" />
            </div>
        </RadzenStack>
    </RadzenStack>
</div>

@if (!FilteredItems.Any())
{
    <EmptyState Kind="EmptyStateKind.NotFound" Title="No matching repositories"
                Description="Try another owner or repository name.">
        <Actions><RadzenButton Text="Clear search" Icon="close" Variant="Variant.Outlined" Click="@(() => SearchChanged.InvokeAsync(string.Empty))" /></Actions>
    </EmptyState>
}
else
{
<div class="rp-card-list">
    @foreach (var row in SortedItems)
    {
        <article class="rp-repo-card" data-repo="@row.Id">
            <div class="rp-repo-card__identity">
                <a class="rp-repo-card__link" href="@($"/repositories/{row.Id}")">@row.Owner/@row.Name</a>
                <GitHubLink Url="@($"https://github.com/{row.Owner}/{row.Name}")"
                            Title="@($"Open {row.Owner}/{row.Name} on GitHub in a new tab")" />
            </div>
            <div class="rp-repo-card__metrics">
                <div><span>Lines</span><strong>@(row.TotalLinesSortValue?.ToString("N0") ?? "—")</strong></div>
                <div><span>Net 30d</span><strong class="@(row.NetChange30Days > 0 ? "rp-delta--pos" : row.NetChange30Days < 0 ? "rp-delta--neg" : "rp-delta--flat")">@(row.NetChange30Days is { } net ? ChartFormat.Delta(net) : "—")</strong></div>
                <div><span>Commits 30d</span><strong>@(row.Commits30Days?.ToString("N0") ?? "—")</strong></div>
            </div>
            <div class="rp-repo-card__footer">
                <div class="rp-repo-card__activity">
                    <AnalysisStatusCell Status="@row.Status" LastError="@row.Repository.LastAnalysisError"
                                        Progress="@(ProgressMap is not null && ProgressMap.TryGetValue(row.Id, out var progress) ? progress : null)"
                                        StartedUtc="@(ReanalysisStartTimes is not null && ReanalysisStartTimes.TryGetValue(row.Id, out var started) ? started : null)" />
                    <span title="@(row.LastAnalyzedCommitDate?.ToString("g") ?? "Never analyzed")">@(ChartFormat.RelativeTime(row.LastAnalyzedCommitDate) is { Length: > 0 } relative ? relative : "Never analyzed")</span>
                </div>
                <div class="rp-repo-card__actions">
                    <RadzenButton Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text"
                                  Click="@(() => OnReanalyze.InvokeAsync(row.Repository))" Disabled="@IsBusy(row.Id)"
                                  title="@($"Re-analyze {row.Owner}/{row.Name}")" aria-label="@($"Re-analyze {row.Owner}/{row.Name}")" />
                    <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                  Click="@(() => OnDelete.InvokeAsync(row.Repository))" title="@($"Delete {row.Owner}/{row.Name}")" aria-label="@($"Delete {row.Owner}/{row.Name}")" />
                </div>
            </div>
        </article>
    }
</div>
}

<div class="u-scroll-x rp-table-view">
    <RadzenDataGrid @ref="Grid"
                    Data="@FilteredItems"
                    TItem="RepositoryGridRow"
                    AllowFiltering="true"
                    FilterMode="FilterMode.Advanced"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    AllowSorting="true"
                    AllowPaging="false"
                    AllowColumnResize="true"
                    AllowColumnPicking="true"
                    PickedColumnsChanged="@OnPickedColumnsChanged"
                    Sort="@OnSort"
                    Responsive="true"
                    RowRender="@OnRowRender"
                    RowClick="@OnRowClick"
                    Density="Density.Compact"
                    class="rp-grid">
        <EmptyTemplate><span class="rp-table-empty">No matching repositories.</span></EmptyTemplate>
        <Columns>
            <RadzenDataGridColumn TItem="RepositoryGridRow" Property="Name" Title="Repository" MinWidth="160px" Width="180px" Sortable="true" Filterable="true" FilterProperty="OwnerName" FilterOperator="FilterOperator.Contains" Pickable="false">
                <Template Context="row">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
                        <RadzenText class="rp-repo-name" title="@($"{row.Owner}/{row.Name}")">@($"{row.Owner}/{row.Name}")</RadzenText>
                        <GitHubLink Url="@($"https://github.com/{row.Owner}/{row.Name}")"
                                    Title="@($"Open {row.Owner}/{row.Name} on GitHub in a new tab")"
                                    StopRowClickPropagation="true" />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RepositoryGridRow" Property="TotalLinesSortValue" Title="Total Lines" Width="100px" TextAlign="TextAlign.Right" Sortable="true" Filterable="true" Visible="@Visible("Total Lines")">
                <Template Context="row">
                    @if (row.TotalLinesSortValue.HasValue)
                    {
                        <RadzenText class="rp-lines-value">@row.TotalLinesSortValue.Value.ToString("N0")</RadzenText>
                    }
                    else if (!TotalsLoaded && row.LastAnalyzedCommitDate.HasValue)
                    {
                        @* Only while the totals request is in flight. Keyed on "no value" alone
                           this shimmered forever when the request failed or the repository has
                           0 counted lines — neither of which is ever going to produce a number. *@
                        <RadzenSkeleton Width="70px" Height="18px" />
                    }
                    else
                    {
                        <RadzenText class="rp-disabled">—</RadzenText>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* The 30-day columns. "—" until the page's insights request lands: it is fetched
               after the grid is on screen, so these never hold up the rows themselves. *@
            <RadzenDataGridColumn TItem="RepositoryGridRow" Property="NetChange30Days" Title="Net (30d)" Width="100px" TextAlign="TextAlign.Right" Sortable="true" Filterable="true" Visible="@Visible("Net (30d)")">
                <Template Context="row">
                    @if (row.NetChange30Days is { } net)
                    {
                        <span class="@(net > 0 ? "rp-delta--pos" : net < 0 ? "rp-delta--neg" : "rp-delta--flat")">@ChartFormat.Delta(net)</span>
                    }
                    else
                    {
                        <RadzenText class="rp-disabled">—</RadzenText>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RepositoryGridRow" Property="Commits30Days" Title="Commits (30d)" Width="110px" TextAlign="TextAlign.Right" Sortable="true" Filterable="true" Visible="@Visible("Commits (30d)")">
                <Template Context="row">
                    @if (row.Commits30Days is { } commits)
                    {
                        @commits.ToString("N0")
                    }
                    else
                    {
                        <RadzenText class="rp-disabled">—</RadzenText>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Cadence (12w)" Width="140px" Sortable="false" Filterable="false" Visible="@Visible("Cadence (12w)")">
                <Template Context="row">
                    @if (row.Movement is { } movement)
                    {
                        var summary = $"Commits per week, last 12 weeks: {string.Join(", ", movement.WeeklyCommits)}";
                        var max = Math.Max(1, movement.WeeklyCommits.DefaultIfEmpty(0).Max());
                        <div class="rp-spark" role="img" aria-label="@summary" title="@summary">
                            @foreach (var week in movement.WeeklyCommits)
                            {
                                <span class="rp-spark__bar" style="@($"height:{Math.Max(6, week * 100 / max)}%")"></span>
                            }
                        </div>
                    }
                    else
                    {
                        <RadzenText class="rp-disabled">—</RadzenText>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* "Last commit", not "Last Analyzed": the value is the newest analysed commit's own
               date, so a repository analysed a minute ago read "3 months ago" under the old title. *@
            <RadzenDataGridColumn TItem="RepositoryGridRow" Property="LastAnalyzedCommitDate" Title="Last commit" Width="120px" Sortable="true" Filterable="true" Visible="@Visible("Last commit")">
                <Template Context="row">
                    @if (row.LastAnalyzedCommitDate.HasValue)
                    {
                        <RadzenStack Gap="0.1rem">
                            <RadzenText class="rp-relative-time">@ChartFormat.RelativeTime(row.LastAnalyzedCommitDate)</RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rp-muted">@row.LastAnalyzedCommitDate.Value.ToString("MM/dd/yy HH:mm")</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Never" />
                    }
                </Template>
            </RadzenDataGridColumn>
            @* Sorts and filters on the stored outcome (RepositoryGridRow.Status): type "failed"
               to find what needs attention. *@
            <RadzenDataGridColumn TItem="RepositoryGridRow" Property="Status" Title="Status" Width="130px" Sortable="true" Filterable="true" FilterOperator="FilterOperator.Contains" Visible="@Visible("Status")">
                <Template Context="row">
                    <AnalysisStatusCell Progress="@(ProgressMap != null && ProgressMap.TryGetValue(row.Id, out var p) ? p : null)"
                                        Status="@row.Status"
                                        LastError="@row.Repository.LastAnalysisError"
                                        StartedUtc="@(ReanalysisStartTimes != null && ReanalysisStartTimes.TryGetValue(row.Id, out var st) ? st : null)" />
                </Template>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="RepositoryGridRow" Title="Actions" Width="80px" TextAlign="TextAlign.Center" Filterable="false" Sortable="false" Pickable="false">
                <Template Context="row">
                    <span @onclick:stopPropagation="true">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                            <RadzenButton Icon="refresh" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined"
                                          Click="@(() => OnReanalyze.InvokeAsync(row.Repository))"
                                          title="Re-analyze from scratch"
                                          aria-label="@($"Re-analyze {row.Owner}/{row.Name}")"
                                          Disabled="@IsBusy(row.Id)" />
                            <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                          Click="@(() => OnDelete.InvokeAsync(row.Repository))"
                                          title="Delete repository"
                                          aria-label="@($"Delete {row.Owner}/{row.Name}")" />
                        </RadzenStack>
                    </span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>

@code {
    /// <summary>The repository rows to render. Computed by the page from <c>pageState.Repositories</c>.</summary>
    [Parameter, EditorRequired] public IEnumerable<RepositoryGridRow> Items { get; set; } = [];

    /// <summary>Active progress frames, keyed by repository id. Owned by the page.</summary>
    [Parameter] public IReadOnlyDictionary<RepositoryId, AnalysisProgressDto>? ProgressMap { get; set; }

    /// <summary>Re-analysis start times, keyed by repository id. Owned by the page.</summary>
    [Parameter] public IReadOnlyDictionary<RepositoryId, DateTime>? ReanalysisStartTimes { get; set; }

    [Parameter] public EventCallback<GitHubRepository> OnReanalyze { get; set; }
    [Parameter] public EventCallback<GitHubRepository> OnDelete { get; set; }
    [Parameter] public EventCallback<DataGridRowMouseEventArgs<RepositoryGridRow>> OnRowClick { get; set; }
    [Parameter] public Action<RowRenderEventArgs<RepositoryGridRow>>? OnRowRender { get; set; }

    /// <summary>Forwarded so the page can call <c>Reload()</c> after a delete.</summary>
    public RadzenDataGrid<RepositoryGridRow>? Grid { get; set; }

    /// <summary>False while the page's first totals request is in flight. Owned by the page.</summary>
    [Parameter] public bool TotalsLoaded { get; set; }

    /// <summary>The name search. Owned by the page, which mirrors it into the query string.</summary>
    [Parameter] public string? Search { get; set; }
    [Parameter] public EventCallback<string> SearchChanged { get; set; }

    // ─── Per-browser grid settings ───────────────────────────────────────────────────────────
    //
    // Sort and hidden columns, kept in localStorage as one delimited string:
    //     "<sort property>|<asc or desc>|<hidden title>,<hidden title>"
    //
    // Not Radzen's DataGridSettings through @bind-Settings. That type carries filter values as
    // `object`, which source-generated JSON cannot describe, and the reflection serializer is
    // deliberately unreachable from this trimmed client (SPEC §6) — it would work in a Debug
    // build and fail in the published one. Column widths and order are what that costs.

    private const string SettingsKey = "repoGrid";

    /// <summary>Columns the picker lists, by title — the title is what the picker hands back.</summary>
    internal static readonly string[] PickableTitles =
        ["Total Lines", "Net (30d)", "Commits (30d)", "Cadence (12w)", "Last commit", "Status"];

    /// <summary>Secondary facts are hidden on small screens and available from the column picker.</summary>
    private static readonly string[] WideOnlyTitles = ["Net (30d)", "Commits (30d)", "Cadence (12w)"];

    internal static readonly string[] SortableProperties =
        ["Name", "TotalLinesSortValue", "NetChange30Days", "Commits30Days", "LastAnalyzedCommitDate", "Status"];

    /// <summary>
    /// Starts with the wide-only columns hidden and reveals them once the viewport is known,
    /// rather than the reverse: three columns appearing on a desktop is a smaller jolt than a
    /// phone's grid opening wider than the screen and snapping back.
    /// </summary>
    private HashSet<string> _hidden = [.. WideOnlyTitles];
    private string? _sortProperty = "Name";
    private bool _sortDescending;

    private bool Shown(string title) => !_hidden.Contains(title);

    private bool _wide;

    /// <summary>Radzen stacks responsive rows below 768px; its table needs room above that.</summary>
    private bool Visible(string title) => Shown(title) && (_wide || !WideOnlyTitles.Contains(title));

    /// <summary>
    /// Reads a saved settings string. localStorage is editable and outlives a deploy, so nothing
    /// in it is trusted: an unknown sort property is dropped (the grid would throw building the
    /// sort expression) and unknown column titles are ignored.
    /// </summary>
    public static (string? SortProperty, bool Descending, HashSet<string> Hidden) ParseSettings(string? saved)
    {
        var parts = (saved ?? string.Empty).Split('|');
        return (
            SortableProperties.Contains(parts[0]) ? parts[0] : null,
            parts.Length > 1 && parts[1] == "desc",
            parts.Length > 2 ? parts[2].Split(',').Intersect(PickableTitles).ToHashSet() : []);
    }

    public static string FormatSettings(string? sortProperty, bool descending, IEnumerable<string> hidden) =>
        $"{sortProperty}|{(descending ? "desc" : "asc")}|{string.Join(',', hidden)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Everything here is optional. Storage can be blocked (private mode, policy) and the
        // interop can fail mid-teardown; the grid has already rendered with its defaults.
        try
        {
            _wide = await JS.GetValueAsync<int>("innerWidth") > 768;
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", SettingsKey);
            if (saved is null)
            {
                if (_wide) _hidden = [];
            }
            else
            {
                (_sortProperty, _sortDescending, _hidden) = ParseSettings(saved);
                if (_sortProperty is not null && Grid is not null)
                {
                    if (_sortDescending) Grid.OrderByDescending(_sortProperty);
                    else Grid.OrderBy(_sortProperty);
                }
            }

            StateHasChanged();
        }
        catch (Exception)
        {
            // Defaults stand.
        }
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", SettingsKey,
                FormatSettings(_sortProperty, _sortDescending, _hidden));
        }
        catch (Exception)
        {
            // Not saved: the choice still holds for this visit.
        }
    }

    protected override void OnInitialized() => Feed.StateChanged += OnFeedStateChanged;

    private bool AnyRunning =>
        ReanalysisStartTimes is { Count: > 0 } || ProgressMap?.Values.Any(p => p.IsRunning) == true;

    /// <summary>Repaints the Streaming / Reconnecting label; raised off the renderer's context.</summary>
    private void OnFeedStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Feed.StateChanged -= OnFeedStateChanged;

    private Task OnSort(DataGridColumnSortEventArgs<RepositoryGridRow> args)
    {
        _sortProperty = args.SortOrder is null ? null : args.Column.Property;
        _sortDescending = args.SortOrder == SortOrder.Descending;
        return SaveSettingsAsync();
    }

    private sealed record SortOption(string Value, string Label);
    private static readonly SortOption[] SortOptions =
    [
        new("Name", "Repository"), new("TotalLinesSortValue", "Total lines"),
        new("NetChange30Days", "Net change"), new("Commits30Days", "Commits"),
        new("LastAnalyzedCommitDate", "Last commit"), new("Status", "Status")
    ];

    private IEnumerable<RepositoryGridRow> SortedItems
    {
        get
        {
            var sorted = (_sortProperty switch
            {
                "TotalLinesSortValue" => FilteredItems.OrderBy(r => r.TotalLinesSortValue ?? -1),
                "NetChange30Days" => FilteredItems.OrderBy(r => r.NetChange30Days),
                "Commits30Days" => FilteredItems.OrderBy(r => r.Commits30Days),
                "LastAnalyzedCommitDate" => FilteredItems.OrderBy(r => r.LastAnalyzedCommitDate),
                "Status" => FilteredItems.OrderBy(r => r.Status),
                _ => FilteredItems.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
            }).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase);
            return _sortDescending ? sorted.OrderByDescending(row => row.TotalLinesSortValue.HasValue).ThenByDescending(row => row.TotalLinesSortValue) : sorted;
        }
    }

    private Task OnSortSelected(string property)
    {
        _sortProperty = property;
        return SaveSettingsAsync();
    }

    private Task ToggleSortDirection()
    {
        _sortDescending = !_sortDescending;
        return SaveSettingsAsync();
    }

    private Task OnPickedColumnsChanged(DataGridPickedColumnsChangedEventArgs<RepositoryGridRow> args)
    {
        _hidden = PickableTitles.Except(args.Columns.Select(column => column.Title)).ToHashSet();
        return SaveSettingsAsync();
    }

    /// <summary>
    /// Whether a re-analysis is already queued or running for this row. Per repository, not a
    /// single "the one being re-analysed" slot: with two jobs in flight the second row's button
    /// stayed live and a click queued the same repository twice. The start-time entry covers the
    /// gap between the click and the first progress frame.
    /// </summary>
    private bool IsBusy(RepositoryId id) =>
        ReanalysisStartTimes?.ContainsKey(id) == true
        || (ProgressMap is not null && ProgressMap.TryGetValue(id, out var progress) && progress.IsRunning);

    private IEnumerable<RepositoryGridRow> FilteredItems =>
        string.IsNullOrWhiteSpace(Search)
            ? Items
            : Items.Where(r => $"{r.Owner}/{r.Name}".Contains(Search, StringComparison.OrdinalIgnoreCase));
}
