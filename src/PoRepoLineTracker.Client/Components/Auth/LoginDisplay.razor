@using Microsoft.AspNetCore.Components.Authorization
@using PoRepoLineTracker.Client.Services
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The wrapper <div> anchors CSS isolation for the Radzen markup below. *@
<div class="login-display">
<AuthorizeView>
    <Authorized>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            @if (!string.IsNullOrEmpty(AuthStateProvider.CurrentUser?.AvatarUrl))
            {
                @* The whole value has to be ONE C# expression. Razor cannot mix an @(...) block
                   with literal text in an attribute (RZ9986), so the concatenation goes inside an
                   interpolated string rather than beside it. *@
                <RadzenImage Path="@AuthStateProvider.CurrentUser!.AvatarUrl"
                             AlternateText="@($"{AuthStateProvider.CurrentUser?.DisplayName ?? AuthStateProvider.CurrentUser?.Username ?? "User"}'s profile picture")"
                             class="login-display__avatar" />
            }
            <RadzenText TextStyle="TextStyle.Body2" class="login-display__identity">
                @(AuthStateProvider.CurrentUser?.Email
                  ?? AuthStateProvider.CurrentUser?.DisplayName
                  ?? AuthStateProvider.CurrentUser?.Username
                  ?? "User")
            </RadzenText>
            <RadzenButton Text="Logout"
                          ButtonStyle="ButtonStyle.Light" 
                          Variant="Variant.Outlined"
                          Size="ButtonSize.Small"
                          Click="@HandleLogout" />
        </RadzenStack>
    </Authorized>
    <NotAuthorized>
        <RadzenButton Text="Sign in with GitHub"
                      Icon="login"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.Small"
                      Click="@HandleLogin" />
    </NotAuthorized>
</AuthorizeView>
</div>

@code {
    private void HandleLogin()
    {
        // Navigate to login endpoint which will redirect to GitHub OAuth
        Navigation.NavigateTo("auth/login", forceLoad: true);
    }

    private async Task HandleLogout()
    {
        // The service worker keeps this user's /auth/me, repositories and insights for offline
        // reads (apiCacheName in service-worker.published.js — keep the name in step). Left
        // behind, the next person on this browser would get them served back while offline.
        // Best-effort: no Cache API (insecure context, old browser) means there is nothing cached.
        try { await JS.InvokeVoidAsync("caches.delete", "porepolinetracker-api-cache"); }
        catch (JSException) { }

        Navigation.NavigateTo("auth/logout", forceLoad: true);
    }
}
