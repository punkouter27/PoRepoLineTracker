@page "/settings"
@attribute [Authorize]
@inject Radzen.NotificationService NotificationService
@inject Radzen.DialogService DialogService
@inject ILogger<ExtensionsCounted> Logger
@inject UserPreferencesClient PreferencesClient
@using Microsoft.AspNetCore.Authorization
@using PoRepoLineTracker.Shared.Domain
@using Radzen
@using Radzen.Blazor

<PageTitle>Settings · PoRepoLineTracker</PageTitle>

@* Nothing is persisted until "Save Changes", and the nav sits one click away: without this a
   stray click dropped every edit silently. ConfirmExternalNavigation covers reload / tab close
   with the browser's own prompt. *@
<NavigationLock ConfirmExternalNavigation="@hasChanges" OnBeforeInternalNavigation="@ConfirmLeaveAsync" />

<div class="app-stack">
    @* This IS the Settings page. It used to be wrapped by a 25-line Settings.razor whose only
       job was to hold the routes, render this hero, and embed this component with its own
       header switched off — one screen, two components, three route declarations. *@
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.15rem">
                <h1 class="page-hero__title ext-title">Settings</h1>
                <RadzenText TextStyle="TextStyle.Body1" class="ext-subtitle">
                    Configure PoRepoLineTracker to match your workflow
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            <RadzenButton Text="Reset to Defaults" 
                          Icon="restore" 
                          ButtonStyle="ButtonStyle.Light"
                          Variant="Variant.Outlined"
                          Size="ButtonSize.Small"
                          Click="@ResetToDefaults"
                          Disabled="@(isLoading || isSaving)" />
            <RadzenButton Text="Save Changes" 
                          Icon="save" 
                          ButtonStyle="ButtonStyle.Success"
                          Size="ButtonSize.Small"
                          Click="@SavePreferences"
                          IsBusy="@isSaving"
                          BusyText="Saving..."
                          Disabled="@(!hasChanges || isLoading)" />
        </Actions>
    </PageHero>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="true" Close="@(() => errorMessage = null)">
            @errorMessage
        </RadzenAlert>
    }

    @if (hasChanges)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true">
            You have unsaved changes. Click "Save Changes" to apply them.
        </RadzenAlert>
    }

    @if (isLoading)
    {
        <RadzenCard>
            <RadzenStack Gap="1rem" AlignItems="AlignItems.Center" class="rz-p-8">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" />
                <RadzenText>Loading preferences...</RadzenText>
            </RadzenStack>
        </RadzenCard>
    }
    else
    {
        <div class="app-dashboard app-dashboard--panels">
            <RadzenCard>
                <RadzenStack Gap="1rem" class="rz-pt-2">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                 JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.H6" class="ext-count-title">Counted Extensions (@(extensionItems?.Count ?? 0))</RadzenText>
                        <RadzenButton Text="Add Extension"
                                      Icon="add"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Size="ButtonSize.Small"
                                      Click="@AddNewExtension" />
                    </RadzenStack>

                    <div class="u-scroll-x">
                    <RadzenDataGrid @ref="extensionGrid"
                                    Data="@extensionItems"
                                    TItem="ExtensionItem"
                                    AllowFiltering="false"
                                    AllowSorting="true"
                                    AllowPaging="false"
                                    EditMode="DataGridEditMode.Single"
                                    RowUpdate="@OnUpdateRow"
                                    RowCreate="@OnCreateRow"
                                    Responsive="true"
                                    Density="Density.Compact"
                                    class="ext-grid">
                        <Columns>
                            <RadzenDataGridColumn TItem="ExtensionItem" Property="Extension" Title="Extension" Width="140px">
                                <Template Context="item">
                                    <code class="ext-code">@item.Extension</code>
                                </Template>
                                <EditTemplate Context="item">
                                    <RadzenTextBox @bind-Value="item.Extension" class="ext-input" autofocus />
                                </EditTemplate>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ExtensionItem" Property="Category" Title="Category" Width="120px">
                                <Template Context="item">
                                    <RadzenBadge BadgeStyle="@GetCategoryBadgeStyle(item.Category)" Text="@item.Category" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="ExtensionItem" Title="Actions" Width="100px" TextAlign="TextAlign.Center" Sortable="false">
                                <Template Context="item">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                        <RadzenButton Icon="edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
                                                      Click="@(() => EditRow(item))" title="Edit"
                                                      aria-label="@($"Edit extension {item.Extension}")" />
                                        <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
                                                      Click="@(() => DeleteRow(item))" title="Delete"
                                                      aria-label="@($"Delete extension {item.Extension}")" />
                                    </RadzenStack>
                                </Template>
                                <EditTemplate Context="item">
                                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" JustifyContent="JustifyContent.Center">
                                        <RadzenButton Icon="check" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Variant="Variant.Text" Click="@(() => SaveRow(item))" title="Save" />
                                        <RadzenButton Icon="close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Click="@(() => CancelEdit(item))" title="Cancel" />
                                    </RadzenStack>
                                </EditTemplate>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                    </div>
                </RadzenStack>
            </RadzenCard>
        </div>

        <RadzenCard class="rz-mt-4">
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" style="font-weight: 600;">GitHub Integration &amp; Permissions</RadzenText>
                <RadzenText TextStyle="TextStyle.Body2">
                    PoRepoLineTracker connects to GitHub using Personal Access Tokens (PAT) or GitHub OAuth to analyze repository trees and commit histories.
                </RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="repo (Full control of private repositories)" />
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="read:user (Read profile data)" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <AccountDataCard />

    }
</div>

@code {
    private RadzenDataGrid<ExtensionItem>? extensionGrid;
    private List<ExtensionItem>? extensionItems;
    private List<ExtensionItem>? originalExtensionItems;
    private string? errorMessage;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool hasChanges = false;
    private UserPreferences? preferences;
    // Set by Reset to Defaults when the user has stored ignore patterns. There is no editor for
    // them any more, so Reset is the only way left to clear patterns the user can no longer see.
    private bool clearGlobs;
    private string newExtensionValue = string.Empty;
    private static readonly Dictionary<string, string[]> categoryMap = new()
    {
        // Tuned for Blazor WebAssembly + .NET API: code files only.
        // Generated, lock, and minified files are intentionally omitted
        // (see FileIgnoreFilter and DefaultFileExtensions in UserPreferences).
        { ".NET", [".cs", ".razor", ".cshtml", ".xaml", ".csproj"] },
        { "JavaScript", [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"] },
        { "Web", [".html", ".css", ".scss", ".less"] },
        { "Python", [".py"] }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadPreferences();
    }

    private async Task LoadPreferences()
    {
        isLoading = true;
        errorMessage = null;
        
        try
        {
            preferences = await PreferencesClient.GetAsync();
            var extensions = preferences?.FileExtensions?.ToList() ?? [];
            extensionItems = extensions.Select(ext => new ExtensionItem { Extension = ext, Category = GetCategory(ext) }).ToList();
            originalExtensionItems = extensionItems.Select(e => new ExtensionItem { Extension = e.Extension, Category = e.Category }).ToList();
            hasChanges = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading user preferences");
            errorMessage = $"Failed to load preferences: {ex.Message}";
            extensionItems = [];
            originalExtensionItems = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetCategory(string extension)
    {
        foreach (var (category, extensions) in categoryMap)
        {
            if (extensions.Contains(extension, StringComparer.OrdinalIgnoreCase))
                return category;
        }
        return "Custom";
    }

    private static BadgeStyle GetCategoryBadgeStyle(string category) => category switch
    {
        ".NET" => BadgeStyle.Primary,
        "Web" => BadgeStyle.Info,
        "JavaScript" => BadgeStyle.Warning,
        "Python" => BadgeStyle.Success,
        "Data" => BadgeStyle.Secondary,
        "Scripts" => BadgeStyle.Dark,
        _ => BadgeStyle.Light
    };

    private async Task AddNewExtension()
    {
        var result = await DialogService.OpenAsync("Add Extension", ds =>
            @<RadzenStack Gap="1rem" class="ext-dialog">
                <RadzenTextBox @bind-Value="@newExtensionValue" Placeholder="e.g., .py or py" class="ext-input" />
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.End">
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => ds.Close(null))" />
                    <RadzenButton Text="Add" ButtonStyle="ButtonStyle.Primary" Click="@(() => ds.Close(newExtensionValue))" />
                </RadzenStack>
            </RadzenStack>,
            new DialogOptions { Width = "350px", Height = "180px" });

        if (result is string { Length: > 0 } typed && ValidateExtension(typed) is { } ext)
        {
            extensionItems ??= [];
            extensionItems.Add(new ExtensionItem { Extension = ext, Category = GetCategory(ext) });
            CheckForChanges();
            await extensionGrid!.Reload();
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Added", Detail = $"Added '{ext}'", Duration = 2000 });
        }
        newExtensionValue = string.Empty;
    }

    /// <summary>
    /// The row being edited and the value it had beforehand. The edit box is <c>@bind</c>-ed
    /// straight to the item, so by the time Cancel is clicked the item already holds whatever was
    /// typed — the grid's CancelEditRow only closes the editor, it does not put anything back.
    /// </summary>
    private ExtensionItem? _editing;
    private string _editSnapshot = string.Empty;

    private async Task EditRow(ExtensionItem item)
    {
        // Single edit mode: opening a second row drops the first one's editor without a Cancel
        // click, so restore that row here or its half-typed value would stay in the list.
        if (_editing is not null) CancelEdit(_editing);

        (_editing, _editSnapshot) = (item, item.Extension);
        await extensionGrid!.EditRow(item);
    }

    private async Task SaveRow(ExtensionItem item)
    {
        // The row stays in edit mode when the check fails. This used to assign
        // NormalizeExtension's result unconditionally — which is "" for invalid input — so an
        // empty extension went into the list and on to the server.
        if (ValidateExtension(item.Extension, self: item) is not { } ext) return;

        item.Extension = ext;
        item.Category = GetCategory(ext);
        _editing = null;
        await extensionGrid!.UpdateRow(item);
        CheckForChanges();
    }

    private void CancelEdit(ExtensionItem item)
    {
        item.Extension = _editSnapshot;
        _editing = null;
        extensionGrid!.CancelEditRow(item);
    }

    private async Task ConfirmLeaveAsync(LocationChangingContext context)
    {
        if (!hasChanges) return;

        var leave = await DialogService.Confirm("You have unsaved changes. Leave without saving?", "Unsaved changes",
            new ConfirmOptions { OkButtonText = "Leave", CancelButtonText = "Stay" });
        if (leave != true) context.PreventNavigation();
    }

    private void OnUpdateRow(ExtensionItem item) => CheckForChanges();
    private void OnCreateRow(ExtensionItem item) => CheckForChanges();

    private async Task DeleteRow(ExtensionItem item)
    {
        var confirmed = await DialogService.Confirm($"Delete '{item.Extension}'?", "Confirm", new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });
        if (confirmed == true)
        {
            extensionItems?.Remove(item);
            CheckForChanges();
            await extensionGrid!.Reload();
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Removed", Detail = $"Removed '{item.Extension}'", Duration = 2000 });
        }
    }

    private void ResetToDefaults()
    {
        extensionItems = UserPreferences.DefaultFileExtensions.Select(ext => new ExtensionItem { Extension = ext, Category = GetCategory(ext) }).ToList();
        clearGlobs = preferences?.CustomIgnoreGlobs is { Count: > 0 };
        CheckForChanges();
        NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Info, Summary = "Reset", Detail = clearGlobs ? "Preferences and saved ignore patterns reset. Save to apply." : "Preferences reset. Save to apply.", Duration = 3000 });
    }

    private void CheckForChanges()
    {
        if (originalExtensionItems == null || extensionItems == null) { hasChanges = false; return; }
        var currentSet = extensionItems.Select(e => e.Extension.ToLowerInvariant()).OrderBy(x => x).ToList();
        var originalSet = originalExtensionItems.Select(e => e.Extension.ToLowerInvariant()).OrderBy(x => x).ToList();
        hasChanges = !currentSet.SequenceEqual(originalSet) || clearGlobs;
    }

    private async Task SavePreferences()
    {
        if (extensionItems == null) return;
        isSaving = true;
        errorMessage = null;

        try
        {
            var updatedPrefs = new UserPreferences
            {
                UserId = preferences?.UserId ?? UserId.Empty,
                FileExtensions = extensionItems.Select(e => e.Extension).ToList(),
                // No editor for these any more (the card was removed), but a user who saved patterns
                // earlier still has them applied by the analysis. Written back untouched unless Reset
                // to Defaults asked to clear them: saving replaces the whole row, so dropping them
                // anywhere else would silently delete patterns the user can no longer see.
                CustomIgnoreGlobs = clearGlobs ? [] : preferences?.CustomIgnoreGlobs ?? [],
                LastSeenUtc = preferences?.LastSeenUtc,
                LastUpdated = DateTime.UtcNow
            };
            preferences = await PreferencesClient.SaveAsync(updatedPrefs);
            originalExtensionItems = extensionItems.Select(e => new ExtensionItem { Extension = e.Extension, Category = e.Category }).ToList();
            clearGlobs = false;
            hasChanges = false;
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Saved", Detail = "Preferences saved. Re-analyze repositories only if you changed extensions.", Duration = 4000 });
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving user preferences");
            errorMessage = $"Failed to save: {ex.Message}";
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Failed", Detail = ex.Message, Duration = 5000 });
        }
        finally
        {
            isSaving = false;
        }
    }

    /// <summary>
    /// The typed extension, normalised, or null after a warning toast when it is invalid or
    /// already listed. <paramref name="self"/> is the row being edited, which may keep its own value.
    /// One copy for Add and for an in-place edit, which had drifted apart once already.
    /// </summary>
    private string? ValidateExtension(string? typed, ExtensionItem? self = null)
    {
        var ext = NormalizeExtension(typed ?? string.Empty);
        if (string.IsNullOrEmpty(ext)) return Warn("Invalid Extension", "Must contain only letters/numbers after dot.");
        if (extensionItems?.Any(e => e != self && e.Extension.Equals(ext, StringComparison.OrdinalIgnoreCase)) == true)
            return Warn("Duplicate", $"'{ext}' already exists.");
        return ext;

        string? Warn(string summary, string detail)
        {
            NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Warning, Summary = summary, Detail = detail, Duration = 3000 });
            return null;
        }
    }

    private static string NormalizeExtension(string ext)
    {
        ext = ext.Trim().ToLowerInvariant();
        if (!ext.StartsWith('.')) ext = "." + ext;
        if (ext.Length < 2 || !ext[1..].All(c => char.IsLetterOrDigit(c))) return string.Empty;
        return ext;
    }

    public class ExtensionItem
    {
        public string Extension { get; set; } = string.Empty;
        public string Category { get; set; } = "Custom";
    }
}
