@page "/year-in-review"
@page "/year-in-review/{Year:int}"
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject ILogger<YearInReview> Logger
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using System.Globalization

<PageTitle>Year in Review @(_data?.Year) · PoRepoLineTracker</PageTitle>

@* A year across every tracked repository on one screen: a hero banner with the headline number
   over a 3D city of the year (js/city.js), a bento grid of the other figures, and the card that
   saves as a PNG. All figures come from one GET (/api/insights/year/{year}).

   It used to be a carousel, one figure per slide; seeing them side by side is the point of a
   recap, so every figure is now a tile. Hovering a tile flies the city's camera to the day or
   month it is about. *@
<div class="app-stack yir">
    <PageHero>
        <Heading>
            <RadzenStack Gap="0.125rem">
                <h1 class="page-hero__title yir-title">Year in Review</h1>
                <RadzenText TextStyle="TextStyle.Body1" class="yir-lede">
                    @if (_data is { HasActivity: true })
                    {
                        <span>Your @_data.Year across @_data.RepositoriesTouched tracked repositor@(_data.RepositoriesTouched == 1 ? "y" : "ies")</span>
                    }
                    else
                    {
                        <span>Your year of commits on one page</span>
                    }
                </RadzenText>
            </RadzenStack>
        </Heading>
        <Actions>
            @if (_data is { AvailableYears.Count: > 0 })
            {
                <RadzenDropDown TValue="int" Data="@_data.AvailableYears" Value="@_data.Year" Change="@(v => OnYearChanged((int)v))"
                                Style="width: 7rem" aria-label="Year" />
            }
        </Actions>
    </PageHero>

    @if (_loading)
    {
        <RadzenCard><RadzenSkeleton Width="100%" Height="320px" /></RadzenCard>
    }
    else if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            @_error
            <RadzenButton Text="Retry" Icon="refresh" Size="ButtonSize.Small" Variant="Variant.Text" Click="@LoadAsync" />
        </RadzenAlert>
    }
    else if (_data is not { HasActivity: true })
    {
        <EmptyState Kind="EmptyStateKind.NoInsights"
                    Title="@($"No commits in {_data?.Year ?? DateTime.Now.Year}")"
                    Description="@(_data?.AvailableYears.Count > 0 ? "Pick another year above." : "Add a repository and let it finish analysing; its history fills this in.")" />
    }
    else
    {
        @* Keyed by year so a new year re-runs the entrance, the roll-up and the city. *@
        <section class="yir-hero u-enter" @key="_data.Year" @ref="_hero" aria-label="@($"{_data.Year} headline")">
            <canvas @ref="_cityCanvas" class="yir-city" aria-hidden="true"></canvas>
            <div class="yir-hero__text">
                <p class="yir-kicker">@_data.Year in code</p>
                <p class="yir-headline"><AnimatedNumber Value="@_data.Commits" RollIn="true" /> commits</p>
                <p class="yir-caption">
                    across @_data.RepositoriesTouched repositor@(_data.RepositoriesTouched == 1 ? "y" : "ies") on @_data.ActiveDays different days
                </p>
            </div>
        </section>

        <div class="yir-bento" @key="(_data.Year, 1)">
            @for (var i = 0; i < _tiles.Count; i++)
            {
                var tile = _tiles[i];
                var index = i;
                <article class="@($"yir-tile u-glass u-enter {tile.Css}")" style="--i:@(i + 1)"
                         @onmouseenter="@(() => FocusCityAsync(tile.FocusDay, index + 1))"
                         @onmouseleave="@(() => FocusCityAsync(-1, 0))">
                    <header class="yir-tile__head">
                        <RadzenIcon Icon="@tile.Icon" class="yir-tile__icon" />
                        <span class="yir-tile__kicker">@tile.Kicker</span>
                    </header>
                    @* On one line: whitespace between the parts would print as a gap ("+ 17,834"). *@
                    <p class="yir-tile__value">@if (tile.Flame) {<span class="u-flame" style="--flame:@ChartFormat.StreakFlame(_data.LongestStreakDays)" aria-hidden="true"></span>}<span>@tile.Prefix</span>@if (tile.Number is { } number) {<AnimatedNumber Value="@number" RollIn="true" />}<span>@tile.Text</span></p>
                    <p class="yir-tile__caption">@tile.Caption</p>
                    @if (tile.ShowMonths)
                    {
                        <svg class="yir-months" viewBox="0 0 360 120" role="img" aria-label="Commits per month">
                            @{ var max = Math.Max(1, _data.MonthlyCommits.Max()); }
                            @for (var m = 0; m < 12; m++)
                            {
                                var h = 90.0 * _data.MonthlyCommits[m] / max;
                                @* In a <g>: a bare <text> directly in a code block is Razor's directive. *@
                                <g>
                                    <rect x="@(m * 30 + 4)" y="@F(96 - h)" width="22" height="@F(Math.Max(h, 1))" rx="3"
                                          class="@(m + 1 == _data.BusiestMonth ? "yir-bar yir-bar--peak" : "yir-bar")">
                                        <title>@MonthName(m + 1): @_data.MonthlyCommits[m] commits</title>
                                    </rect>
                                    <text x="@(m * 30 + 15)" y="114" text-anchor="middle" class="yir-month-label">@(MonthName(m + 1)[..1])</text>
                                </g>
                            }
                        </svg>
                    }
                </article>
            }
        </div>

        <section class="yir-summary" aria-label="Shareable card">
            @* Foil that tilts toward the pointer (.u-holo). On a wrapper, so the exported PNG is the plain card. *@
            <div class="yir-holo u-holo">
                <svg @ref="_card" class="yir-card" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg" role="img"
                     aria-label="@($"{_data.Year} summary card")">
                    @* Plain hex colours and system fonts, not theme tokens: this SVG is also
                       exported as a standalone image, where the page's CSS does not exist. *@
                    <defs>
                        <linearGradient id="yir-bg" x1="0" y1="0" x2="1" y2="1">
                            <stop offset="0" stop-color="#4c1d95" />
                            <stop offset="0.55" stop-color="#6750a4" />
                            <stop offset="1" stop-color="#c02d76" />
                        </linearGradient>
                    </defs>
                    <rect width="1200" height="630" rx="36" fill="url(#yir-bg)" />
                    <g font-family="system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" fill="#ffffff">
                        <text x="72" y="118" font-size="34" font-weight="600" fill-opacity="0.8">My @_data.Year in code</text>
                        <text x="72" y="214" font-size="92" font-weight="800">@_data.Commits.ToString("N0") commits</text>
                        @{ var stats = SummaryStats(); }
                        @for (var i = 0; i < stats.Count; i++)
                        {
                            var (label, value) = stats[i];
                            var x = 72 + (i % 3) * 360;
                            var y = 330 + (i / 3) * 130;
                            <g>
                                <text x="@x" y="@y" font-size="24" fill-opacity="0.75">@label</text>
                                <text x="@x" y="@(y + 52)" font-size="44" font-weight="700">@value</text>
                            </g>
                        }
                        <text x="72" y="590" font-size="22" fill-opacity="0.6">PoRepoLineTracker</text>
                    </g>
                </svg>
            </div>
            <RadzenButton Text="Download PNG" Icon="download" Click="@DownloadCardAsync" class="yir-download" />
        </section>
    }
</div>

@code {
    [Parameter] public int? Year { get; set; }

    private YearInReviewDto? _data;
    private List<Tile> _tiles = [];
    private bool _loading = true;
    private string? _error;
    private int _offsetMinutes;
    private int? _loadedYear;
    private ElementReference _card;
    private ElementReference _hero;
    private ElementReference _cityCanvas;
    private IJSObjectReference? _cityModule;
    private IJSObjectReference? _city;
    private string? _cityCanvasId;

    /// <summary>
    /// One figure. <see cref="Number"/> rolls up on an odometer, between <see cref="Prefix"/> and
    /// <see cref="Text"/>; figures that are not counts (a month, a name) are all <see cref="Text"/>.
    /// </summary>
    /// <param name="FocusDay">0-based day of the year the city's camera flies to on hover, or -1 for a framing of its own.</param>
    /// <param name="Css">Size in the bento grid: <c>yir-tile--wide</c>, <c>yir-tile--feature</c> or none.</param>
    private sealed record Tile(string Kicker, string Icon, string Caption, int? Number = null, string Prefix = "", string Text = "",
        int FocusDay = -1, string Css = "", bool ShowMonths = false, bool Flame = false);

    protected override async Task OnParametersSetAsync()
    {
        var year = Year ?? DateTime.Now.Year;
        if (_loadedYear == year) return;
        _loadedYear = year;

        // From the browser, not TimeZoneInfo.Local: the WASM runtime's zone data is optional
        // and trimming may leave it as UTC.
        _offsetMinutes = await JS.InvokeAsync<int>("utcOffsetMinutes");
        await LoadAsync();

        // Landing on /year-in-review in a quiet year (early January, say) would open on an empty
        // page while last year has a story. Only for the default year: an explicit one is honoured.
        if (Year is null && _data is { HasActivity: false, AvailableYears.Count: > 0 })
            Navigation.NavigateTo($"/year-in-review/{_data.AvailableYears[0]}", replace: true);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _data = await Http.GetAppJsonAsync($"/api/insights/year/{_loadedYear}?offset={_offsetMinutes}", AppJsonSerializerContext.Default.YearInReviewDto);
            _tiles = _data is { HasActivity: true } ? BuildTiles(_data) : [];
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Year in review failed to load for {Year}", _loadedYear);
            _error = $"Could not load the year: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // The grid is four columns: wide tiles take two, the feature tile (the month chart) two by
    // two, and `dense` packing fills single tiles around it. In this order a year with every
    // optional figure fills four full rows; a missing one leaves a gap only on the last.
    private static List<Tile> BuildTiles(YearInReviewDto d)
    {
        var tiles = new List<Tile>
        {
            new("Lines written", "edit_note",
                $"about {d.LinesAdded / Math.Max(1, d.ActiveDays):N0} a day on the days you committed",
                Number: d.LinesAdded, Prefix: "+", Css: "yir-tile--wide"),
            new("Lines removed", "content_cut", $"net {d.LinesAdded - d.LinesRemoved:+#,0;-#,0;0} lines",
                Number: d.LinesRemoved, Prefix: d.LinesRemoved > 0 ? "−" : ""),
            new("Active days", "event_available", $"{100.0 * d.ActiveDays / d.DailyCommits.Count:0}% of the year had a commit",
                Number: d.ActiveDays),
            new("Busiest month", "calendar_month", $"{d.MonthlyCommits[d.BusiestMonth - 1]:N0} commits",
                Text: MonthName(d.BusiestMonth, full: true), FocusDay: new DateTime(d.Year, d.BusiestMonth, 15).DayOfYear - 1,
                Css: "yir-tile--feature", ShowMonths: true),
            new("Longest streak", "local_fire_department", "in a row with at least one commit",
                Number: d.LongestStreakDays, Text: d.LongestStreakDays == 1 ? " day" : " days", Flame: d.LongestStreakDays > 0),
            new(d.PeakHour is >= 21 or < 5 ? "Night owl" : d.PeakHour < 9 ? "Early bird" : "Peak hour", "schedule",
                $"your most common commit hour; {CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)d.PeakWeekday)}s were busiest",
                Text: HourLabel(d.PeakHour)),
        };

        if (d.BiggestDay is { } day)
            tiles.Add(new("Biggest day", "bolt", $"+{d.BiggestDayLinesAdded:N0} lines added in a single day",
                Text: day.ToString("MMMM d", CultureInfo.CurrentCulture), FocusDay: day.DayOfYear - 1));
        if (d.TopRepository is not null)
            tiles.Add(new("Most active repository", "star", $"{d.TopRepositoryCommits:N0} commits", Text: d.TopRepository));

        // Snapshots at the year's two ends (RepositoryTotals), so a portfolio can shrink.
        var growth = d.PortfolioLinesEnd - d.PortfolioLinesStart;
        tiles.Add(new("Portfolio growth", "stacked_line_chart",
            d.PortfolioLinesStart > 0
                ? $"from {d.PortfolioLinesStart:N0} to {d.PortfolioLinesEnd:N0} lines ({100.0 * growth / d.PortfolioLinesStart:+0;-0;0}%)"
                : $"to {d.PortfolioLinesEnd:N0} lines",
            Number: Math.Abs(growth), Prefix: growth < 0 ? "−" : "+", Css: "yir-tile--wide"));
        tiles.Add(new("Repositories touched", "folder_copy", "had at least one commit this year", Number: d.RepositoriesTouched));

        if (d.TopGrowingExtension is not null)
            tiles.Add(new("On the rise", "trending_up", $"grew by {d.TopGrowingSharePoints:0.#} points of your portfolio's share",
                Text: d.TopGrowingExtension));

        return tiles;
    }

    private List<(string Label, string Value)> SummaryStats() =>
    [
        ("Lines added", $"+{_data!.LinesAdded:N0}"),
        ("Longest streak", $"{_data.LongestStreakDays} days"),
        ("Active days", $"{_data.ActiveDays}"),
        ("Busiest month", MonthName(_data.BusiestMonth, full: true)),
        ("Peak hour", HourLabel(_data.PeakHour)),
        ("Top repository", Truncate(_data.TopRepository ?? "—", 14))
    ];

    /// <summary>
    /// The effects, all decoration: a failure (no WebGL2, an import the network refused, teardown)
    /// leaves the page exactly as it is. The city is mounted once per canvas element, which Blazor
    /// replaces when the year changes, and it releases its own GL context when that canvas leaves
    /// the page. Each new year celebrates once, after the tiles have cascaded in.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _data is not { HasActivity: true }) return;
        try
        {
            if (_cityCanvasId == _cityCanvas.Id) return;
            _cityCanvasId = _cityCanvas.Id;
            _cityModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/city.js");
            if (_city is not null) await _city.DisposeAsync();
            _city = await _cityModule.InvokeAsync<IJSObjectReference>("mount", _cityCanvas, string.Join(',', _data.DailyCommits), _data.Year);
            _ = CelebrateAsync(_data.Year);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Year in review effects unavailable");
        }
    }

    private async Task CelebrateAsync(int year)
    {
        await Task.Delay(1600);
        if (_data?.Year != year || _city is null) return;
        try
        {
            await JS.InvokeVoidAsync("fx.fireworks", _hero);
            await JS.InvokeVoidAsync("fx.yearChord", string.Join(',', _data.MonthlyCommits));
        }
        catch (Exception) { }
    }

    /// <param name="framing">Which of the city's camera framings to use when there is no day to fly to.</param>
    private async Task FocusCityAsync(int day, int framing)
    {
        if (_city is null) return;
        try { await _city.InvokeVoidAsync("focus", day, framing); }
        catch (Exception) { }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_city is not null)
            {
                await _city.InvokeVoidAsync("dispose");
                await _city.DisposeAsync();
            }
            if (_cityModule is not null) await _cityModule.DisposeAsync();
        }
        catch (Exception)
        {
            // JSDisconnectedException on teardown; the city disposes itself once its canvas is gone.
        }
    }

    private void OnYearChanged(int year) => Navigation.NavigateTo($"/year-in-review/{year}");

    private async Task DownloadCardAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("downloadSvgAsPng", _card, $"year-in-review-{_data!.Year}.png");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "PNG export failed");
            Notifications.Notify(NotificationSeverity.Warning, "Download failed", "This browser could not turn the card into an image.", 5000);
        }
    }

    private static string MonthName(int month, bool full = false) =>
        month is < 1 or > 12 ? "—"
        : full ? CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
        : CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(month);

    private static string HourLabel(int hour) => DateTime.Today.AddHours(hour).ToString("h tt", CultureInfo.InvariantCulture);

    private static string Truncate(string text, int max) => text.Length <= max ? text : text[..(max - 1)] + "…";

    private static string F(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
