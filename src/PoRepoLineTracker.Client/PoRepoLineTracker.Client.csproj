<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Rule 1.2 — trimming enabled.
         The former blocker was reflection-based JSON: with the reflection resolver reachable, the
         trimmer had to keep member metadata alive for anything that might be serialized, and the
         published app failed at runtime with 'CtorNotLocated' for MainLayout. AppJsonSerializerContext
         removed that resolver from the client entirely (see AppJsonOptions), so the only remaining
         reflection is Blazor's own component activation — which the SDK roots for us, plus the
         explicit roots in TrimmerRoots.xml for the types reached only from markup.
         AOT stays off: it is a separate switch with a large build-time cost and no rule requiring it. -->
    <IsAotCompatible>false</IsAotCompatible>
    <PublishTrimmed>true</PublishTrimmed>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Report every trim warning, including those originating in referenced assemblies (Radzen).
         Without this the analyzer is silent about exactly the code most likely to break. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- IL2110/IL2111: raised against Razor-generated code for <Router NotFoundPage> and
         <LayoutView Layout="typeof(MainLayout)">. Both are Blazor's own reflection over types
         carrying [DynamicallyAccessedMembers], in code this project does not author and cannot
         annotate. They are suppressed only because TrimmerRoots.xml preserves both app assemblies
         outright, so the members the trimmer cannot prove reachable are in fact kept — remove the
         roots and these must be un-suppressed with them. -->
    <NoWarn>$(NoWarn);IL2110;IL2111</NoWarn>
    <!-- Emits wwwroot/service-worker-assets.js at publish time: one entry per published asset
         with its integrity hash, plus a version stamp derived from them. service-worker.published.js
         imports it to build its cache and to name that cache, which is what makes a deploy
         invalidate the previous shell instead of merging into it. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The dev worker is a no-op and the published one caches the shell; see the header comment
         in each. Swapping them at publish time is what keeps a stale cache from masquerading as a
         failed local build. -->
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <!-- IHttpClientFactory: lets AntiforgeryHandler be composed into the pipeline as a named
         client (Rule 4.2) instead of every call site constructing its own HttpClient. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- Live analysis feed. Trim-safe only because the hub protocol is handed the same
         source-generated resolver the HTTP calls use — see AnalysisFeedClient. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Radzen.Blazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoRepoLineTracker.Shared\PoRepoLineTracker.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- YYMMDD build stamp shown bottom-right by App.razor. UTC build date, not commit date, so
         re-running an old commit's deploy stamps it with the re-run day. -->
    <AssemblyMetadata Include="BuildVersion" Value="$([System.DateTime]::UtcNow.ToString('yyMMdd'))" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

</Project>
