<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Azure & Identity -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.4.0" />
    <!-- Azure & Storage -->
    <PackageVersion Include="Azure.Data.Tables" Version="12.11.0" />
    <!-- Microsoft Core Extensions (.NET 10) -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Live analysis feed. Client-side only: the server hub ships in the ASP.NET Core shared
         framework, so nothing is added to the API for it. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <!-- HybridCache is the standard cache abstraction (in-memory L1 with
         stampede protection; an L2 is added by registering an IDistributedCache). -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <!-- Git & Source Control -->
    <PackageVersion Include="LibGit2Sharp" Version="0.31.0" />
    <!-- Static analysis. The SYNTAX half of Roslyn only: the C# parser needs no SDK, no MSBuild
         and no restored compilation, which is what lets code metrics run on the F1 App Service.
         Do not add Workspaces.MSBuild to reach Depth of Inheritance / Class Coupling without
         reading the note on RoslynMetricsAnalyzer first - it drags in Microsoft.Build packages
         carrying high-severity advisories, and this solution builds with TreatWarningsAsErrors. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- UI Components -->
    <PackageVersion Include="Radzen.Blazor" Version="8.4.2" />
    <!-- Logging (Serilog) -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <!-- OpenAPI -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.13.20" />
    <!-- Authentication -->
    <PackageVersion Include="AspNet.Security.OAuth.GitHub" Version="9.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.13" />
    <!-- Git-Driven Versioning -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <!-- Testing Frameworks — single stack: xunit + NSubstitute + FluentAssertions.
         Playwright uses the core package (no NUnit/MSTest base) so E2EUI stays on xunit. -->
    <PackageVersion Include="Testcontainers.Azurite" Version="4.6.0" />
    <!-- Transitive pin: Testcontainers pulls SSH.NET 2024.2.0, which carries advisory
         GHSA-q939-rpr3-3284; NU1903 + TreatWarningsAsErrors fails the build without this. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FluentAssertions" Version="8.8.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.55.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>
</Project>